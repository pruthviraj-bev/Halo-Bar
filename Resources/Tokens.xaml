<?xml version="1.0" encoding="utf-8" ?>
<!--
    Design Tokens — frozen token scale from 03-Design-Tokens.md.

    Token-only resource dictionary. Every value lives here; consumers reference
    these keys and never inline raw values. Merged into App.xaml alongside
    Resources/ThemeResources.xaml.

    Flagged notes for review:
      - Semantic roles marked "NEW" have no existing brush in ThemeResources.xaml;
        their values follow the app's dark palette (white text #FFFFFF on the
        transparent/acrylic taskbar, accent #FF8B5CF6, ~#15FFFFFF tile fills used
        across the existing widgets). Light-theme variants are deferred — the app
        currently never switches themes (no RequestedTheme/ElementTheme usage).
      - Elevation.Flat/Raised/Overlay are PLACEHOLDERS (border-thickness
        variation) per Tokens §5: "exact values decided when Shadows.xaml is
        written". No ThemeShadow/DropShadow resources exist in the project yet.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════ Spacing (x:Double, DIPs) — Tokens §1 ═══════════ -->
    <x:Double x:Key="Spacing.XS">4</x:Double>
    <x:Double x:Key="Spacing.S">8</x:Double>
    <x:Double x:Key="Spacing.M">12</x:Double>
    <x:Double x:Key="Spacing.L">16</x:Double>
    <x:Double x:Key="Spacing.XL">24</x:Double>
    <x:Double x:Key="Spacing.XXL">32</x:Double>

    <!-- ═══════════ Corner Radius (CornerRadius) — Tokens §2 ═══════════ -->
    <CornerRadius x:Key="Radius.Small">8</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">12</CornerRadius>
    <CornerRadius x:Key="Radius.Large">16</CornerRadius>
    <CornerRadius x:Key="Radius.Capsule">999</CornerRadius>

    <!-- ═══════════ Color — Semantic roles — Tokens §4 ═══════════
         Mapped roles mirror the dark ThemeResources brushes as concrete
         SolidColorBrush values. (An earlier revision used
         <ThemeResource ResourceKey="..."/> aliases, but those aliases cannot be
         resolved at runtime by consumers and throw at XAML load — see
         WidgetCard. The app never switches themes, so concrete dark values are
         safe; revisit aliasing if theme support is ever added.) -->

    <SolidColorBrush x:Key="Semantic.Surface.Default" Color="Transparent" />
    <SolidColorBrush x:Key="Semantic.Text.Primary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Semantic.Text.Secondary" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Semantic.Accent.Primary" Color="#FF5B9CFF" />

    <!-- NEW — no existing ThemeResources brush for this role.
         #15FFFFFF matches the tile/surface fill already used across MediaWidget,
         ExpandedDashboard, etc. on the acrylic taskbar. -->
    <SolidColorBrush x:Key="Semantic.Surface.Raised" Color="#15FFFFFF" />

    <!-- NEW — lighter glass tint for insets/scroll surfaces over the acrylic. -->
    <SolidColorBrush x:Key="Semantic.Surface.Glass" Color="#08FFFFFF" />

    <!-- NEW — 2% white chip for the dashboard footer metric/weather clusters
         (α 0x05) — a barely-there raise over the dashboard surface. -->
    <SolidColorBrush x:Key="Semantic.Surface.Raised05" Color="#05FFFFFF" />

    <!-- PASS 3 (V1 REDESIGN): the unified card surface — black @ ~20% (α 0x33),
         painted over the single Halo backdrop (DesignRules §3.4 Surface.CardTint,
         PROPOSED → landed). Cards read darker/more opaque than the parent
         dashboard (~15% tint) but stay translucent — never opaque black. -->
    <SolidColorBrush x:Key="Semantic.Surface.CardTint" Color="#33000000" />

    <!-- PASS 6 (V1 REDESIGN): clipboard item cards + filter pills — white @ ~10%
         (α 0x1A) over the CardTint surface, so rows read as content sitting
         inside the glass (subtle raise, never separate windows). -->
    <SolidColorBrush x:Key="Semantic.Surface.ClipItem" Color="#1AFFFFFF" />

    <!-- Item-row hover: +2% white over ClipItem (α 0x1A → 0x1D) — a restrained
         brighten on the Bluetooth/clipboard rows, no elevation edge. -->
    <SolidColorBrush x:Key="Semantic.Surface.ClipItemHover" Color="#1DFFFFFF" />

    <!-- PASS 6 (V1 REDESIGN): clipboard search field — black @ ~5% (α 0x0D),
         a recessed glass input on the CardTint surface (inputs recede, items
         raise). -->
    <SolidColorBrush x:Key="Semantic.Surface.SearchInput" Color="#0D000000" />

    <!-- NEW — default card border, visible against the transparent taskbar. -->
    <SolidColorBrush x:Key="Semantic.Border.Default" Color="#14FFFFFF" />

    <!-- NEW — subtler divider/hairline border. -->
    <SolidColorBrush x:Key="Semantic.Border.Subtle" Color="#14FFFFFF" />

    <!-- PASS 4 (V1 REDESIGN): accent family — Halo Azure per DesignRules §3.4.1
         (purple #FF8B5CF6 REPLACED; Hover #70AAFF / Pressed #4A8FEF CONFIRMED). -->
    <SolidColorBrush x:Key="Semantic.Accent.Hover" Color="#FF70AAFF" />
    <SolidColorBrush x:Key="Semantic.Accent.Pressed" Color="#FF4A8FEF" />

    <!-- NEW — status/state roles, Fluent-consistent hues on dark. -->
    <SolidColorBrush x:Key="Semantic.State.Success" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="Semantic.State.Warning" Color="#FFFFB900" />
    <SolidColorBrush x:Key="Semantic.State.Danger" Color="#FFFF5F52" />
    <SolidColorBrush x:Key="Semantic.State.Muted" Color="#59FFFFFF" />

    <!-- ═══════════ Elevation — Tokens §5 ═══════════
         PLACEHOLDERS: project has no ThemeShadow/DropShadow resources yet.
         Border-thickness variation stands in so consumers can apply elevation
         now; real depth/shadow values deferred to Shadows.xaml per Tokens §5. -->
    <Style x:Key="Elevation.Flat" TargetType="Border">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="Elevation.Raised" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Elevation.Overlay" TargetType="Border">
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- ═══════════ Typography — Tokens §3 (Style → TextBlock) ═══════════ -->
    <Style x:Key="Type.Display" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Type.LargeNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Type.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Type.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Type.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="Type.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="Type.Micro" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- ═══════════ Motion (x:Double, milliseconds) — Tokens §6 ═══════════ -->
    <x:Double x:Key="Motion.Micro">120</x:Double>
    <x:Double x:Key="Motion.Standard">180</x:Double>
    <x:Double x:Key="Motion.Emphasized">250</x:Double>
    <x:Double x:Key="Motion.Completion">450</x:Double>

    <!-- ═══════════ Iconography (x:Double, DIPs) — Tokens §7 ═══════════ -->
    <x:Double x:Key="Icon.Small">16</x:Double>
    <x:Double x:Key="Icon.Default">20</x:Double>
    <x:Double x:Key="Icon.Primary">24</x:Double>

    <!-- ═══════════ Control Sizing (x:Double, DIPs) — Tokens §8 ═══════════ -->
    <x:Double x:Key="Control.Small">28</x:Double>
    <x:Double x:Key="Control.Default">36</x:Double>
    <x:Double x:Key="Control.Large">44</x:Double>

</ResourceDictionary>
