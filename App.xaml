<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DynamicIsland.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:DynamicIsland.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Resources/ThemeResources.xaml" />
                <ResourceDictionary Source="Resources/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:PlayPauseIconConverter x:Key="PlayPauseIconConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
