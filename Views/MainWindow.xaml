<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DynamicIsland.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DynamicIsland.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DynamicIsland"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerPressed="RootGrid_PointerPressed"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          AutomationProperties.Name="Dynamic Island Container">

        <!-- 1. Expanded Dashboard (fills the window; Pass 9 crossfade: fades +
             scales in from the compact pill region while the window grows).
             Opacity/scale are driven by ViewModel properties that follow the
             geometry animation's shared progress.
             PASS 1 (V1 REDESIGN): outer radius 16 DIP and a 3 DIP edge
             clearance on the left + bottom (Margin 3,0,0,3), so the dashboard
             no longer visually touches the left edge or the taskbar boundary.
             Height is set in code (640); the compact pill below keeps its own
             24 DIP radius and flush-left home (pill not redesigned). -->
        <Border x:Name="DashboardBorder"
                Background="{ThemeResource IslandBackgroundBrush}"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="16"
                Margin="3,0,0,3"
                Opacity="{x:Bind ViewModel.DashboardOpacity, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ExpandedVisibility, Mode=OneWay}">
            <Border.RenderTransform>
                <!-- Render-only transform (no layout cost): CenterX at the compact
                     pill's horizontal center (~0.28 of the 620-DIP dashboard width:
                     pill center ≈175 / 620), CenterY at the bottom edge adjacent to
                     the pill — so the dashboard visually grows out of the pill,
                     not from nowhere. -->
                <ScaleTransform x:Name="DashboardScaleTransform"
                                CenterX="0.28"
                                CenterY="1.0"
                                ScaleX="{x:Bind ViewModel.DashboardScale, Mode=OneWay}"
                                ScaleY="{x:Bind ViewModel.DashboardScale, Mode=OneWay}" />
            </Border.RenderTransform>
            <ContentControl
                x:Name="DashboardHost"
                Content="{x:Bind ViewModel.Dashboard, Mode=OneWay}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </Border>

        <!-- 2. Compact pill — bottom overlay (not a layout row) so it never
             consumes space during the transition: both surfaces coexist and
             crossfade while the window geometry animates, then the pill is
             collapsed at the end of expansion. -->
        <Border x:Name="PillBorder"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="0"
                Opacity="{x:Bind ViewModel.PillOpacity, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.PillVisibility, Mode=OneWay}"
                AutomationProperties.Name="Dynamic Island Pill">

            <!-- Inside the collapsed capsule, center the active content vertically -->
            <Grid Padding="10,0,10,0">
                <ContentControl
                    x:Name="WidgetHost"
                    Content="{x:Bind ViewModel.ActiveWidget, Mode=OneWay}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="Widget Host" />
            </Grid>
        </Border>
    </Grid>
</Window>
