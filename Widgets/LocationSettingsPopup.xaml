<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DynamicIsland.Widgets.LocationSettingsPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DynamicIsland.Widgets"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CityItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </UserControl.Resources>

    <Border Background="{ThemeResource Semantic.Surface.Raised}"
            BorderBrush="{ThemeResource Semantic.Border.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Width="280">
        <StackPanel Spacing="12">
            <TextBlock Text="Location" FontSize="14" FontWeight="Bold"
                       Foreground="{ThemeResource TextPrimaryBrush}"/>

            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="Automatic" FontSize="12"
                           Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <ToggleSwitch Grid.Column="1" x:Name="AutoToggle" MinWidth="0"
                              OnContent="" OffContent="" HorizontalAlignment="Right"
                              Toggled="AutoToggle_Toggled"/>
            </Grid>

            <StackPanel x:Name="SearchPanel" Visibility="Collapsed" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0" x:Name="SearchBox" PlaceholderText="Search city..."
                             FontSize="12" KeyDown="SearchBox_KeyDown"/>
                    <Button Grid.Column="1" x:Name="SearchButton" Content="Search"
                            Style="{StaticResource SearchButtonStyle}" Click="SearchButton_Click"/>
                </Grid>

                <ListView x:Name="ResultsList" MaxHeight="160" Background="Transparent"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="ResultsList_ItemClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:CityResult">
                            <Border Style="{StaticResource CityItemStyle}">
                                <TextBlock Text="{x:Bind DisplayName}" FontSize="12"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextSecondaryBrush}" Visibility="Collapsed"/>
                <Button x:Name="RetryButton" Content="Search unavailable — tap to retry"
                        FontSize="11" Padding="0" HorizontalAlignment="Left"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{ThemeResource AccentBrush}"
                        Visibility="Collapsed" Click="RetryButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="CurrentLabel" FontSize="11" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextSecondaryBrush}"/>
        </StackPanel>
    </Border>
</UserControl>
