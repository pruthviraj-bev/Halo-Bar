<UserControl
    x:Class="DynamicIsland.Widgets.PillDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="using:DynamicIsland.Widgets.Cards"
    xmlns:helpers="using:DynamicIsland.Helpers"
    xmlns:controls="using:DynamicIsland.Controls">

    <UserControl.Resources>
        <helpers:FolderFileIconConverter x:Key="FolderFileIconConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <helpers:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragEnter="OnDragEnter"
          DragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop"
          Background="Transparent">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="ShelfCollapsed">
                    <VisualState.Setters>
                        <Setter Target="ShelfPanel.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ShelfExpanded">
                    <VisualState.Setters>
                        <Setter Target="ShelfPanel.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Orientation="Vertical">

            <!-- Shelf panel — visible when shelf icon clicked -->
            <Grid x:Name="ShelfPanel"
                  Visibility="Collapsed"
                  Height="280"
                  Padding="12,10"
                  PointerPressed="OnShelfPanelPointerPressed"
                  Tapped="OnShelfPanelTapped">

                <StackPanel Spacing="10">

                    <!-- Drag-out handle: drag here to move staged files to Explorer/desktop.
                         CanDrag + DragStarting (not StartDragAsync) so the drag ghost can
                         show the real file icon via DragUI.SetContentFromBitmapImage. -->
                    <Border x:Name="DragOutHandle"
                            Background="#15FFFFFF"
                            CornerRadius="8"
                            Height="32"
                            AllowDrop="True"
                            CanDrag="True"
                            DragStarting="OnDragStarting"
                            DropCompleted="OnDropCompleted"
                            DragOver="OnDragOver"
                            Drop="OnDrop">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                            <TextBlock Text="⠿"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="drag out · drop files here"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- File list — vertical rows: thumbnail left, name right -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Enabled"
                                  MaxHeight="160">
                        <ItemsControl x:Name="FileList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="helpers:StashedFile">
                                    <!-- Single tap selects; double-tap opens; ✕ removes. -->
                                    <Grid ColumnDefinitions="48,*,Auto"
                                          Height="52"
                                          Background="Transparent"
                                          Tapped="OnFileRowTapped"
                                          DoubleTapped="OnFileRowDoubleTapped"
                                          PointerEntered="OnFileRowPointerEntered"
                                          PointerExited="OnFileRowPointerExited">
                                        <!-- 48×48 cell: glyph fallback underneath,
                                             shell thumbnail layered on top -->
                                        <Grid Grid.Column="0"
                                              Width="48" Height="48"
                                              HorizontalAlignment="Center">
                                            <controls:AppIcon
                                                Kind="{x:Bind IsFolder,
                                                    Converter={StaticResource FolderFileIconConverter}}"
                                                Visibility="{x:Bind Thumbnail,
                                                    Converter={StaticResource NullToVisibilityInverseConverter}}"
                                                Width="32" Height="32"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                            <Image Source="{x:Bind Thumbnail}"
                                                   Visibility="{x:Bind Thumbnail,
                                                       Converter={StaticResource NullToVisibilityConverter}}"
                                                   Stretch="Uniform"
                                                   Width="48" Height="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        </Grid>
                                        <!-- Name + open affordance -->
                                        <Grid Grid.Column="1"
                                              ColumnDefinitions="*,Auto"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,0">
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Name}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <controls:AppIcon Grid.Column="1"
                                                              Kind="OpenInNew"
                                                              Width="10" Height="10"
                                                              Fill="{ThemeResource TextSecondaryBrush}"
                                                              Opacity="0.6"
                                                              VerticalAlignment="Center"
                                                              Margin="4,0,4,0"
                                                              ToolTipService.ToolTip="Open"/>
                                        </Grid>
                                        <Button Grid.Column="2"
                                                Click="OnFileRowRemoveClick"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Padding="6"
                                                Width="28" Height="28"
                                                CornerRadius="6"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Remove from shelf">
                                            <controls:AppIcon Kind="Dismiss"
                                                              Width="12" Height="12"
                                                              Fill="{ThemeResource TextSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Divider + Clear -->
                    <Border Height="1" Background="#22FFFFFF"/>
                    <Button Content="Clear all"
                            Click="OnClearClick"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            FontSize="11"
                            PointerPressed="OnShelfPanelPointerPressed"/>

                </StackPanel>
            </Grid>

            <!-- PASS 56: transient "Drop here" popup — appears ABOVE the compact
                 pill while an external file drag hovers over it. It is an
                 in-flow StackPanel row (chip + small gap) that occupies the band
                 the popup region grows into above the pill, horizontally
                 centered on the pill, so the compact card strip below never
                 moves and the pill content stays visible underneath. The native
                 PillDropOverlay HWND owns the actual drag interaction, so this
                 layer is hit-test transparent and purely visual. -->
            <Border x:Name="DropHerePopup"
                    Visibility="Collapsed"
                    Opacity="0"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    CornerRadius="24"
                    BorderThickness="1"
                    BorderBrush="#33FFFFFF"
                    Padding="22,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F41C1E26" Offset="0"/>
                        <GradientStop Color="#F210131A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <CompositeTransform x:Name="DropHerePopupTransform"
                                        CenterX="0.5"
                                        CenterY="0.5"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <controls:AppIcon Kind="Folder"
                                      Width="14" Height="14"
                                      Fill="{ThemeResource TextPrimaryBrush}"/>
                    <TextBlock Text="Drop here"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Card strip — always visible -->
            <Grid>
                <StackPanel x:Name="CardStrip"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <cards:WeatherPillCard x:Name="WeatherCard"/>
                    <cards:MusicPillCard x:Name="MusicCard"
                                        Visibility="Collapsed"/>
                    <cards:FileShelfPillCard x:Name="ShelfCard"
                                            Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

        </StackPanel>

    </Grid>
</UserControl>