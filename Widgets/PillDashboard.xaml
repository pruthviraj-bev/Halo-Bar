<UserControl
    x:Class="DynamicIsland.Widgets.PillDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="using:DynamicIsland.Widgets.Cards"
    xmlns:helpers="using:DynamicIsland.Helpers"
    xmlns:controls="using:DynamicIsland.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <UserControl.Resources>
        <helpers:FolderFileIconConverter x:Key="FolderFileIconConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <helpers:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter"/>

        <!-- PASS 16: Halo scrollbar for the Drag Out item list — same template
             family as the Clipboard/Bluetooth cards (thin rounded thumb on a
             transparent track, no native Windows chrome; Azure on hover/drag). -->
        <ControlTemplate x:Key="ScrollBarTransparentButtonTemplate" TargetType="primitives:RepeatButton">
            <Grid Background="Transparent"/>
        </ControlTemplate>

        <Style x:Key="HaloScrollBarStyle" TargetType="primitives:ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ScrollBar">
                        <Grid x:Name="VerticalRoot" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Rectangle x:Name="VerticalTrackRect" Grid.RowSpan="5" Fill="Transparent" Opacity="0"/>
                            <primitives:RepeatButton x:Name="VerticalSmallDecrease" Grid.Row="0" Opacity="0" IsTabStop="False"
                                                     Template="{StaticResource ScrollBarTransparentButtonTemplate}"/>
                            <primitives:RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" Opacity="0" IsTabStop="False"
                                                     Template="{StaticResource ScrollBarTransparentButtonTemplate}"/>
                            <primitives:Thumb x:Name="VerticalThumb" Grid.Row="2" Width="10"
                                              Background="{StaticResource Semantic.State.Muted}"
                                              AutomationProperties.AccessibilityView="Raw"
                                              PointerEntered="ShelfScrollThumb_PointerEntered"
                                              PointerExited="ShelfScrollThumb_PointerExited"
                                              PointerPressed="ShelfScrollThumb_PointerPressed"
                                              PointerReleased="ShelfScrollThumb_PointerReleased"
                                              PointerCaptureLost="ShelfScrollThumb_PointerCaptureLost">
                                <primitives:Thumb.Template>
                                    <ControlTemplate TargetType="primitives:Thumb">
                                        <Border x:Name="ThumbVisual" CornerRadius="2" Margin="3,0,3,0"
                                                Background="{TemplateBinding Background}"/>
                                    </ControlTemplate>
                                </primitives:Thumb.Template>
                            </primitives:Thumb>
                            <primitives:RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3" Opacity="0" IsTabStop="False"
                                                     Template="{StaticResource ScrollBarTransparentButtonTemplate}"/>
                            <primitives:RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Opacity="0" IsTabStop="False"
                                                     Template="{StaticResource ScrollBarTransparentButtonTemplate}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="HaloScrollViewerTemplate" TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollContentPresenter x:Name="ScrollContentPresenter"
                                        Grid.ColumnSpan="2"
                                        Margin="{TemplateBinding Padding}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"/>
                <Grid Grid.Column="1"
                      Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                    <primitives:ScrollBar x:Name="VerticalScrollBar"
                                          Style="{StaticResource HaloScrollBarStyle}"
                                          IsTabStop="False"
                                          Maximum="{TemplateBinding ScrollableHeight}"
                                          Orientation="Vertical"
                                          Value="{TemplateBinding VerticalOffset}"
                                          ViewportSize="{TemplateBinding ViewportHeight}"
                                          HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragEnter="OnDragEnter"
          DragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop"
          Background="Transparent">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="ShelfCollapsed">
                    <VisualState.Setters>
                        <Setter Target="ShelfPanel.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ShelfExpanded">
                    <VisualState.Setters>
                        <Setter Target="ShelfPanel.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Orientation="Vertical">

            <!-- Shelf panel — visible when shelf icon clicked.
                 PASS 16: Drag Out redesign — dark translucent glass outer surface
                 (same language as the pill shell), [icon] DRAG OUT header, a
                 fixed-height scrollable item list recessed in a darker inner
                 container (custom Halo scrollbar), glass item cards (white tint;
                 Azure ~70% when selected), and a centered trash footer. -->
            <Grid x:Name="ShelfPanel"
                  Visibility="Collapsed"
                  Height="280"
                  PointerPressed="OnShelfPanelPointerPressed"
                  Tapped="OnShelfPanelTapped">

                <Border Background="#0D000000"
                        CornerRadius="12"
                        Padding="3">
                    <StackPanel Spacing="8">

                        <!-- PASS 16 header: [Drag Out icon] DRAG OUT. The header row
                             is also the drag-out surface — CanDrag + DragStarting
                             (not StartDragAsync) so the ghost can show the real file
                             icon via DragUI.SetContentFromBitmapImage.
                             PASS 16 r1: the header container is inset to the same
                             width as an item card (Margin 2 = the list container's
                             2 DIP padding, so both start/end at the same x), uses
                             the same white translucent glass tint as the item
                             cards, and the icon + title are centered within it. -->
                        <Border x:Name="DragOutHandle"
                                Height="30"
                                CornerRadius="8"
                                Background="#12FFFFFF"
                                Margin="2,0"
                                AllowDrop="True"
                                CanDrag="True"
                                DragStarting="OnDragStarting"
                                DropCompleted="OnDropCompleted"
                                DragOver="OnDragOver"
                                Drop="OnDrop">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                <controls:AppIcon Kind="DragOut"
                                                  Width="14" Height="14"
                                                  Fill="{ThemeResource AccentBrush}"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Text="DRAG OUT"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- PASS 16: fixed-height item-list container — darker
                             translucent recessed surface, custom Halo scrollbar.
                             Fixed height: the panel never grows with item count. -->
                        <Border Background="#14000000"
                                CornerRadius="8"
                                Padding="2">
                            <ScrollViewer Template="{StaticResource HaloScrollViewerTemplate}"
                                          VerticalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Enabled"
                                          Height="176">
                                <ItemsControl x:Name="FileList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="helpers:StashedFile">
                                            <!-- PASS 16 item card: white translucent
                                                 glass surface. Single tap selects
                                                 (Azure ~70% from code-behind),
                                                 double-tap opens, ✕ removes. -->
                                            <Border CornerRadius="8"
                                                    Padding="6,4"
                                                    Background="#12FFFFFF"
                                                    Tapped="OnFileRowTapped"
                                                    DoubleTapped="OnFileRowDoubleTapped"
                                                    PointerEntered="OnFileRowPointerEntered"
                                                    PointerExited="OnFileRowPointerExited">
                                                <Grid ColumnDefinitions="48,*,Auto"
                                                      Height="48">
                                                    <!-- 48×48 cell: glyph fallback underneath,
                                                         shell thumbnail layered on top -->
                                                    <Grid Grid.Column="0"
                                                          Width="48" Height="48"
                                                          HorizontalAlignment="Center">
                                                        <controls:AppIcon
                                                            Kind="{x:Bind IsFolder,
                                                                Converter={StaticResource FolderFileIconConverter}}"
                                                            Visibility="{x:Bind Thumbnail,
                                                                Converter={StaticResource NullToVisibilityInverseConverter}}"
                                                            Width="32" Height="32"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                        <Image Source="{x:Bind Thumbnail}"
                                                               Visibility="{x:Bind Thumbnail,
                                                                   Converter={StaticResource NullToVisibilityConverter}}"
                                                               Stretch="Uniform"
                                                               Width="48" Height="48"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <!-- Name + open affordance -->
                                                    <Grid Grid.Column="1"
                                                          ColumnDefinitions="*,Auto"
                                                          VerticalAlignment="Center"
                                                          Margin="8,0,0,0">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{x:Bind Name}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                        <controls:AppIcon Grid.Column="1"
                                                                          Kind="OpenInNew"
                                                                          Width="10" Height="10"
                                                                          Fill="{ThemeResource TextSecondaryBrush}"
                                                                          Opacity="0.6"
                                                                          VerticalAlignment="Center"
                                                                          Margin="4,0,4,0"
                                                                          ToolTipService.ToolTip="Open"/>
                                                    </Grid>
                                                    <Button Grid.Column="2"
                                                            Click="OnFileRowRemoveClick"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="0"
                                                            Padding="6"
                                                            Width="28" Height="28"
                                                            CornerRadius="6"
                                                            VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Remove from shelf">
                                                        <controls:AppIcon Kind="Dismiss"
                                                                          Width="12" Height="12"
                                                                          Fill="{ThemeResource TextSecondaryBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- PASS 16 footer: divider + centered trash -->
                        <Border Height="1" Background="#22FFFFFF"/>
                        <Button Click="OnClearClick"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                CornerRadius="16"
                                PointerPressed="OnShelfPanelPointerPressed"
                                ToolTipService.ToolTip="Clear shelf">
                            <controls:AppIcon Kind="Delete"
                                              Width="16" Height="16"
                                              Fill="{ThemeResource TextSecondaryBrush}"/>
                        </Button>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- PASS 56: transient "Drop here" popup — appears ABOVE the compact
                 pill while an external file drag hovers over it. It occupies the
                 band the popup region grows into above the pill, flush on the
                 pill's top edge (no gap), pill-width, ~3× the pill height.
                 PASS 15 redesign: two translucent glass layers in the Halo Bar
                 language — a black-tinted outer surface (fully translucent,
                 ~5%) with 5 DIP padding, and a white-tinted inner drop zone
                 (~10%) inset by that padding so it reads as a recessed surface,
                 not a floating window. Centered all-caps bold "DROP HERE"
                 label, no icon, no secondary labels, no explicit border stroke
                 (the outer/inner tint contrast implies the boundary). The
                 native PillDropOverlay HWND owns the actual drag interaction,
                 so this layer is hit-test transparent and purely visual. -->
            <Border x:Name="DropHerePopup"
                    Visibility="Collapsed"
                    Opacity="0"
                    IsHitTestVisible="False"
                    CornerRadius="22"
                    Background="#0D000000"
                    Padding="5">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="DropHerePopupTransform"
                                        CenterX="0.5"
                                        CenterY="0.5"/>
                </Border.RenderTransform>
                <!-- Inner drop zone: white translucent tint, slightly tighter
                     radius than the outer surface; the 5 DIP padding shows the
                     darker outer layer as an implied rim. -->
                <Border CornerRadius="19"
                        Background="#1AFFFFFF"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch">
                    <TextBlock Text="DROP HERE"
                               FontSize="16"
                               FontWeight="Bold"
                               CharacterSpacing="120"
                               Foreground="#F5FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Border>

            <!-- PASS 18: Bluetooth connected popup — a temporary notification
                 shown ABOVE the compact pill when a device transitions into
                 the Connected state (never on initial discovery of an
                 already-connected device). Same popup-band mechanism as the
                 Drop here zone: the pill region grows upward via
                 StartSizeAnimation and this in-flow row occupies the revealed
                 band, flush on the pill's top edge — a temporary extension of
                 Halo Bar, not a separate notification window. Two-layer glass
                 in the Halo Bar language: dark translucent outer surface
                 (~5% black) with a white translucent inner card (~5% white)
                 containing the device PNG, prominent name, green Connected
                 status, and the battery row (only when Windows exposes
                 battery). Hit-test transparent — the pill keeps its own
                 click behavior. Entrance/exit choreography + auto-dismiss
                 live in code-behind (see OnBluetoothDeviceChanged). -->
            <Border x:Name="BluetoothPopup"
                    Visibility="Collapsed"
                    Opacity="0"
                    IsHitTestVisible="False"
                    CornerRadius="16"
                    Background="#0D000000"
                    Padding="3">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="BluetoothPopupTransform"
                                        CenterX="0.5"
                                        CenterY="0.5"/>
                </Border.RenderTransform>
                <!-- Inner card: white translucent surface. PASS 18.2: the card
                     hosts TWO layouts and code-behind picks the one matching
                     the pill's current card composition (ResolveBluetoothPopupLayout):
                       • HORIZONTAL (music and/or pomodoro present) — image in
                         a fixed left column, name/Connected/battery stacked
                         right, vertically centered. Image art is sized up in
                         code (64 × ArtZoomFor) so the visible PNG art fills
                         the 64 DIP box flush-left while the canvas padding
                         overflows invisibly (no RenderTransform — that proved
                         unreliable).
                       • VERTICAL (weather only — narrow pill) — image centered
                         at the top, name below, Connected + battery on one
                         centered line below that. Only one layout is Visible
                         at a time; the popup height follows the mode. -->
                <Border CornerRadius="13"
                        Background="#0DFFFFFF"
                        Padding="12,10">
                    <Grid>
                        <!-- ── HORIZONTAL layout ── -->
                        <Grid x:Name="BluetoothPopupHorizontalLayout"
                              ColumnDefinitions="Auto,*">
                            <!-- Device PNG (fallback Fluent Bluetooth glyph when
                                 the type has no asset). Fixed 64×64 column. -->
                            <Grid Grid.Column="0"
                                  Width="64" Height="64"
                                  VerticalAlignment="Center">
                                <Image x:Name="BluetoothPopupDeviceImage"
                                       Stretch="Uniform"
                                       Width="64" Height="64"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                <controls:AppIcon x:Name="BluetoothPopupFallbackIcon"
                                                  Kind="Bluetooth"
                                                  Width="36" Height="36"
                                                  Fill="{ThemeResource TextSecondaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Visibility="Collapsed"/>
                            </Grid>
                            <!-- Text stack: explicit row Grid so name and
                                 "Connected" share the same left X by
                                 construction (no per-element offsets). -->
                            <Grid Grid.Column="1"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="3"
                                  VerticalAlignment="Center"
                                  Margin="14,0,0,0">
                                <TextBlock x:Name="BluetoothPopupDeviceName"
                                           Grid.Row="0"
                                           HorizontalAlignment="Left"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="170"/>
                                <TextBlock x:Name="BluetoothPopupStatusText"
                                           Grid.Row="1"
                                           HorizontalAlignment="Left"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Semantic.State.Success}"
                                           Text="Connected"/>
                                <!-- Battery row — collapsed unless Windows
                                     exposes a battery level (never a fake 0%). -->
                                <StackPanel x:Name="BluetoothPopupBatteryRow"
                                            Grid.Row="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Spacing="5"
                                            Visibility="Collapsed">
                                    <controls:AppIcon x:Name="BluetoothPopupBatteryIcon"
                                                      Width="13" Height="13"
                                                      Fill="{ThemeResource TextSecondaryBrush}"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BluetoothPopupBatteryText"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ── VERTICAL layout (weather-only pill) ── -->
                        <StackPanel x:Name="BluetoothPopupVerticalLayout"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                            <Grid Width="64" Height="64"
                                  HorizontalAlignment="Center">
                                <Image x:Name="BluetoothPopupVerticalImage"
                                       Stretch="Uniform"
                                       Width="64" Height="64"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                <controls:AppIcon x:Name="BluetoothPopupVerticalFallback"
                                                  Kind="Bluetooth"
                                                  Width="36" Height="36"
                                                  Fill="{ThemeResource TextSecondaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="BluetoothPopupVerticalName"
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="150"/>
                            <!-- Connected + battery on one centered line. -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="8">
                                <TextBlock x:Name="BluetoothPopupVerticalStatus"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Semantic.State.Success}"
                                           Text="Connected"/>
                                <StackPanel x:Name="BluetoothPopupVerticalBatteryRow"
                                            Orientation="Horizontal"
                                            Spacing="5"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <controls:AppIcon x:Name="BluetoothPopupVerticalBatteryIcon"
                                                      Width="13" Height="13"
                                                      Fill="{ThemeResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="BluetoothPopupVerticalBatteryText"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- PASS 9 (final geometry): outer widget — fully translucent
                 black ~2% tint (#05000000), a MODERATE rounded rectangle
                 (CornerRadius 12 — NOT a capsule; no 999 / half-height
                 radius), 2 DIP from the taskbar's left edge. Height =
                 TaskbarHeightDips − 2 (set in code-behind — never hardcoded).
                 3 DIP padding all sides; the inner white 1% rounded panel
                 (MusicPillCard, CornerRadius 12 — matched) sits inside with a
                 faint dark glass rim.

                 KEY FIX: CardStrip is a Grid (not StackPanel) so children
                 STRETCH to fill the pill height instead of measuring at their
                 tiny desired size. This eliminates the empty space around the
                 content that previous passes could not fix. Weather/Shelf
                 cards keep their own explicit sizes (28/32 DIP, centered). -->
            <Border x:Name="CardStripBorder"
                    Background="#05000000"
                    CornerRadius="12"
                    Padding="3"
                    HorizontalAlignment="Left">
                <Grid x:Name="CardStrip"
                      ColumnDefinitions="Auto,Auto,Auto,Auto"
                      HorizontalAlignment="Center">

                    <cards:WeatherPillCard x:Name="WeatherCard" Grid.Column="0"/>
                    <cards:MusicPillCard x:Name="MusicCard" Grid.Column="1"
                                        Visibility="Collapsed"/>
                    <cards:FileShelfPillCard x:Name="ShelfCard" Grid.Column="2"
                                            Visibility="Collapsed"
                                            Margin="5,0,0,0"/>
                    <cards:PomodoroPillCard x:Name="PomoCard" Grid.Column="3"
                                           Visibility="Collapsed"
                                           Margin="5,0,0,0"/>
                </Grid>
            </Border>

        </StackPanel>

    </Grid>
</UserControl>