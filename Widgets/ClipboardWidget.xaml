<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DynamicIsland.Widgets.ClipboardWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:DynamicIsland.Helpers"
    xmlns:controls="using:DynamicIsland.Controls"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    PointerPressed="OnPointerPressed">

    <UserControl.Resources>
        <helpers:NullToVisibilityConverter     x:Key="NullToVis" />
        <helpers:NullToVisibilityInverseConverter x:Key="NullToVisInv" />

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent" />
            <Setter Property="BorderBrush"      Value="Transparent" />
            <Setter Property="BorderThickness"  Value="0" />
            <Setter Property="Padding"          Value="0" />
            <Setter Property="Width"            Value="32" />
            <Setter Property="Height"           Value="32" />
            <Setter Property="CornerRadius"     Value="16" />
            <Setter Property="FontSize"         Value="12" />
            <Setter Property="Foreground"       Value="{ThemeResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" VerticalAlignment="Center">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Collapsed">
                    <VisualState.Setters>
                        <Setter Target="CollapsedRow.Visibility" Value="Visible" />
                        <Setter Target="ExpandedRow.Visibility"  Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Expanded">
                    <VisualState.Setters>
                        <Setter Target="CollapsedRow.Visibility" Value="Collapsed" />
                        <Setter Target="ExpandedRow.Visibility"  Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- ── COLLAPSED: compact single-line banner ─────────────────────── -->
        <Border x:Name="CollapsedRow"
                VerticalAlignment="Center"
                Height="36"
                Padding="10,0"
                CornerRadius="10"
                Background="{StaticResource Semantic.Surface.Raised05}"
                BorderBrush="{StaticResource Semantic.Border.Subtle}"
                BorderThickness="1">

            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

                <!-- Type-specific Icon (Text/Image/Files) -->
                <controls:AppIcon Grid.Column="0"
                                  Kind="{x:Bind ViewModel.TypeIconKind, Mode=OneWay}"
                                  Width="14" Height="14"
                                  Fill="{ThemeResource AccentBrush}"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>

                <!-- Primary text: inline-truncated content -->
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"
                           VerticalAlignment="Center"/>

                <!-- Secondary tag: "Copied" — green success chip -->
                <Border Grid.Column="2"
                        Background="#1A4ADE80"
                        CornerRadius="8"
                        Padding="6,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <controls:AppIcon Kind="Checkmark" Width="10" Height="10" Fill="{StaticResource Semantic.State.Success}" VerticalAlignment="Center"/>
                        <TextBlock Text="Copied"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Semantic.State.Success}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ── EXPANDED: scrollable preview + actions ────────────────── -->
        <Grid x:Name="ExpandedRow"
              Visibility="Collapsed"
              RowDefinitions="*,Auto"
              Height="160"
              Padding="10,8,10,6">

            <!-- Row 0: preview area -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                <!-- Fallback icon / Image thumbnail -->
                <Grid Grid.Column="0"
                      Width="36" Height="36"
                      CornerRadius="6"
                      Background="#12FFFFFF"
                      Margin="0,0,10,0"
                      VerticalAlignment="Top">
                    <Image Source="{x:Bind ViewModel.ImagePreview, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.ImagePreview, Converter={StaticResource NullToVis}, Mode=OneWay}"
                           Stretch="UniformToFill" />
                    <controls:AppIcon Kind="{x:Bind ViewModel.TypeIconKind, Mode=OneWay}"
                                      Width="16" Height="16"
                                      Fill="{ThemeResource AccentBrush}"
                                      Visibility="{x:Bind ViewModel.ImagePreview, Converter={StaticResource NullToVisInv}, Mode=OneWay}" />
                </Grid>

                <!-- Scrollable text content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="4">
                    <TextBlock Text="Clipboard Content"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    
                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{x:Bind ViewModel.RawContent, Mode=OneWay}"
                                   FontSize="10.5"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <!-- Row 1: Actions ribbon -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4,0,0" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Detail, Mode=OneWay}" FontSize="9.5" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                
                <Button Grid.Column="1" Style="{StaticResource PillButton}"
                        Command="{x:Bind ViewModel.ReCopyCommand}"
                        ToolTipService.ToolTip="Re-copy" Margin="0,0,8,0">
                    <controls:AppIcon Kind="Copy" Width="20" Height="20"/>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource PillButton}"
                        Command="{x:Bind ViewModel.DeleteCommand}"
                        ToolTipService.ToolTip="Delete from history" Margin="0,0,8,0">
                    <controls:AppIcon Kind="Delete" Width="20" Height="20"/>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource PillButton}"
                        Command="{x:Bind ViewModel.DismissCommand}"
                        ToolTipService.ToolTip="Dismiss">
                    <controls:AppIcon Kind="Dismiss" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
