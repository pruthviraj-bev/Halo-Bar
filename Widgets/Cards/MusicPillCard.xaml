<UserControl
    x:Class="DynamicIsland.Widgets.Cards.MusicPillCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DynamicIsland.Controls"
    xmlns:helpers="using:DynamicIsland.Helpers">

    <UserControl.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <helpers:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter"/>
        <helpers:PlayPauseIconConverter x:Key="PlayPauseIconConverter"/>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- PASS 9 (final geometry): inner music surface — fully translucent
         white ~1% tint (#03FFFFFF), a MODERATE rounded rectangle
         (CornerRadius 12 — NOT a capsule; no 999 / half-height radius).
         2 DIP internal padding all sides. Sits INSIDE the outer black 2%
         rounded-rectangle shell (PillDashboard CardStripBorder, CornerRadius
         12 — matched, 3 DIP padding) so a thin dark glass rim separates the
         two layers: taskbar → black 2% rounded shell → 3 DIP rim → white
         1% rounded panel → 2 DIP → content.

         ContentGrid height + album art size are set DYNAMICALLY from
         code-behind (ContentAreaHeight = taskbar − 10) so the content fills
         the available pill height instead of measuring at its tiny desired
         size — the parent CardStrip is now a Grid (not StackPanel) so the
         capsule stretches to the pill height and the content scales with it. -->
    <Border x:Name="RootCapsule"
            Background="#03FFFFFF"
            CornerRadius="12"
            Padding="2">

        <Grid x:Name="ContentGrid"
              ColumnDefinitions="Auto,Auto,Auto,Auto">

            <!-- Col 0: Album art — sized dynamically (taskbar − 12 → 36 DIP),
                 rounded square (radius 6), strongest visual element. Left inset
                 (4) keeps it off the capsule edge per the reference. MusicNote
                 fallback. -->
            <Grid x:Name="AlbumArt"
                  Grid.Column="0"
                  Width="32" Height="32"
                  CornerRadius="6"
                  Background="#15FFFFFF"
                  Margin="4,0,8,0"
                  VerticalAlignment="Center">
                <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                       Visibility="{x:Bind Thumbnail,
                           Converter={StaticResource NullToVisibilityConverter},
                           Mode=OneWay}"
                       Stretch="UniformToFill"/>
                <controls:AppIcon x:Name="AlbumFallback"
                                  Kind="MusicNote"
                                  Width="12" Height="12"
                                  Fill="{ThemeResource TextSecondaryBrush}"
                                  Visibility="{x:Bind Thumbnail,
                                      Converter={StaticResource NullToVisibilityInverseConverter},
                                      Mode=OneWay}"/>
            </Grid>

            <!-- Col 1: Title (13 DIP, semibold) + Artist (10.5 DIP, secondary) -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                <TextBlock x:Name="TitleText"
                           Text="{x:Bind Title, Mode=OneWay}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="110"/>
                <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                           FontSize="10.5"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="110"
                           Margin="0,1,0,0"/>
            </StackPanel>

            <!-- Col 2: 4-bar visualizer (matches the reference) — Azure while
                 playing, visible neutral white when idle. No background. -->
            <StackPanel x:Name="VisualizerPanel"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="3"
                        Height="24"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                <Border x:Name="WBar0" Width="4" Height="12" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
                <Border x:Name="WBar1" Width="4" Height="18" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
                <Border x:Name="WBar2" Width="4" Height="10" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
                <Border x:Name="WBar3" Width="4" Height="20" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Col 3: Playback controls — white Fluent icons, no backgrounds,
                 ~20 DIP glyphs on 30 DIP hit targets, play/pause slightly larger -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource PillButtonStyle}"
                        Click="OnPreviousClick"
                        ToolTipService.ToolTip="Previous">
                    <controls:AppIcon Kind="Previous" Width="20" Height="20"/>
                </Button>
                <Button Style="{StaticResource PillButtonStyle}"
                        Click="OnPlayPauseClick"
                        ToolTipService.ToolTip="Play/Pause">
                    <controls:AppIcon Kind="{x:Bind IsPlaying,
                                          Converter={StaticResource PlayPauseIconConverter},
                                          Mode=OneWay}"
                                      Filled="True"
                                      Width="22" Height="22"/>
                </Button>
                <Button Style="{StaticResource PillButtonStyle}"
                        Click="OnNextClick"
                        ToolTipService.ToolTip="Next">
                    <controls:AppIcon Kind="Next" Width="20" Height="20"/>
                </Button>
            </StackPanel>

        </Grid>

    </Border>
</UserControl>
