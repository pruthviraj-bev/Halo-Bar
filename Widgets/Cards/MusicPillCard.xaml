<UserControl
    x:Class="DynamicIsland.Widgets.Cards.MusicPillCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DynamicIsland.Controls"
    xmlns:helpers="using:DynamicIsland.Helpers">

    <UserControl.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <helpers:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter"/>
        <helpers:PlayPauseIconConverter x:Key="PlayPauseIconConverter"/>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
          VerticalAlignment="Center"
          Margin="4,0,4,0">

        <!-- Col 0: Album art, 32×32 circle, MusicNote fallback -->
        <Grid Grid.Column="0"
              Width="32" Height="32"
              CornerRadius="16"
              Background="#15FFFFFF"
              Margin="0,0,8,0"
              VerticalAlignment="Center">
            <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                   Visibility="{x:Bind Thumbnail,
                       Converter={StaticResource NullToVisibilityConverter},
                       Mode=OneWay}"
                   Stretch="UniformToFill"/>
            <controls:AppIcon Kind="MusicNote"
                              Width="12" Height="12"
                              Fill="{ThemeResource TextSecondaryBrush}"
                              Visibility="{x:Bind Thumbnail,
                                  Converter={StaticResource NullToVisibilityInverseConverter},
                                  Mode=OneWay}"/>
        </Grid>

        <!-- Col 1: Title + Artist stacked -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="110"/>
            <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                       FontSize="8.5"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="110"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Col 2: 5-bar animated waveform -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="2.5"
                    Height="14"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center">
            <Border x:Name="WBar0" Width="2.5" Height="6"  CornerRadius="1.25" Background="#15FFFFFF" VerticalAlignment="Center"/>
            <Border x:Name="WBar1" Width="2.5" Height="10" CornerRadius="1.25" Background="#15FFFFFF" VerticalAlignment="Center"/>
            <Border x:Name="WBar2" Width="2.5" Height="5"  CornerRadius="1.25" Background="#15FFFFFF" VerticalAlignment="Center"/>
            <Border x:Name="WBar3" Width="2.5" Height="12" CornerRadius="1.25" Background="#15FFFFFF" VerticalAlignment="Center"/>
            <Border x:Name="WBar4" Width="2.5" Height="8"  CornerRadius="1.25" Background="#15FFFFFF" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Col 3: Playback controls -->
        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
            <Button Style="{StaticResource PillButtonStyle}"
                    Click="OnPreviousClick"
                    ToolTipService.ToolTip="Previous">
                <controls:AppIcon Kind="Previous" Width="14" Height="14"/>
            </Button>
            <Button Style="{StaticResource PillButtonStyle}"
                    Click="OnPlayPauseClick"
                    ToolTipService.ToolTip="Play/Pause">
                <controls:AppIcon Kind="{x:Bind IsPlaying,
                                      Converter={StaticResource PlayPauseIconConverter},
                                      Mode=OneWay}"
                                  Filled="True"
                                  Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource PillButtonStyle}"
                    Click="OnNextClick"
                    ToolTipService.ToolTip="Next">
                <controls:AppIcon Kind="Next" Width="14" Height="14"/>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>