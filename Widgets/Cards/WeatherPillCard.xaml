<UserControl
    x:Class="DynamicIsland.Widgets.Cards.WeatherPillCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DynamicIsland.Controls">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Height="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:AppIcon Grid.Column="0"
                          Kind="{x:Bind IconKind, Mode=OneWay}"
                          Width="16" Height="16"
                          Fill="#FFFFD700"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"/>

        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{ThemeResource TextPrimaryBrush}">
            <Run Text="{x:Bind TempText, Mode=OneWay}" FontWeight="SemiBold"/>
            <Run Text="{x:Bind ConditionText, Mode=OneWay}"
                 Foreground="{ThemeResource TextSecondaryBrush}"/>
        </TextBlock>
    </Grid>
</UserControl>