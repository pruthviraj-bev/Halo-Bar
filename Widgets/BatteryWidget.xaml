<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DynamicIsland.Widgets.BatteryWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DynamicIsland.Controls"
    SizeChanged="OnSizeChanged">

    <UserControl.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent" />
            <Setter Property="BorderBrush"      Value="Transparent" />
            <Setter Property="BorderThickness"  Value="0" />
            <Setter Property="Padding"          Value="0" />
            <Setter Property="Width"            Value="30" />
            <Setter Property="Height"           Value="30" />
            <Setter Property="CornerRadius"     Value="15" />
            <Setter Property="FontSize"         Value="12" />
        </Style>

        <!-- Pulse animation storyboard for charging bolt -->
        <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="BatteryChargingBolt"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.6" Duration="0:0:1"
                             AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="BatteryChargingBoltExpanded"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.6" Duration="0:0:1"
                             AutoReverse="True"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Collapsed">
                    <VisualState.Setters>
                        <Setter Target="CollapsedRow.Visibility" Value="Visible" />
                        <Setter Target="ExpandedRow.Visibility"  Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Expanded">
                    <VisualState.Setters>
                        <Setter Target="CollapsedRow.Visibility" Value="Collapsed" />
                        <Setter Target="ExpandedRow.Visibility"  Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- ── COLLAPSED: single-line banner ─────────────────────────────── -->
        <Grid x:Name="CollapsedRow"
              ColumnDefinitions="Auto,*,Auto"
              VerticalAlignment="Center"
              Padding="4,0">

            <!-- Battery glyph with charging bolt overlay -->
            <Grid Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Center">
                <controls:AppIcon Kind="{x:Bind ViewModel.BatteryIconKind, Mode=OneWay}"
                                  Width="12" Height="12"
                                  Fill="{ThemeResource TextSecondaryBrush}" />
                <controls:AppIcon x:Name="BatteryChargingBolt"
                                  Kind="Flash" Filled="True"
                                  Width="8" Height="8"
                                  Fill="#FFFFD700"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,-2,-2"
                                  Visibility="{x:Bind ViewModel.IsChargingVisibility, Mode=OneWay}"/>
            </Grid>

            <!-- Status text -->
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <!-- Percentage -->
            <TextBlock Grid.Column="2"
                       Text="{x:Bind ViewModel.ChargePercentText, Mode=OneWay}"
                       FontSize="11"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       Margin="7,0,0,0" />
        </Grid>

        <!-- ── EXPANDED: progress + details ──────────────────────────────── -->
        <Grid x:Name="ExpandedRow"
              Visibility="Collapsed"
              RowDefinitions="Auto,Auto,Auto"
              Padding="4,4,4,2">

            <!-- Row 0: Battery glyph + status -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*"
                  Margin="0,0,0,8">

                <!-- Large battery glyph with charging bolt overlay -->
                <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                    <controls:AppIcon Kind="{x:Bind ViewModel.BatteryIconKind, Mode=OneWay}"
                                      Width="24" Height="24"
                                      Fill="{ThemeResource TextSecondaryBrush}" />
                    <controls:AppIcon x:Name="BatteryChargingBoltExpanded"
                                      Kind="Flash" Filled="True"
                                      Width="12" Height="12"
                                      Fill="#FFFFD700"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,-3,-3"
                                      Visibility="{x:Bind ViewModel.IsChargingVisibility, Mode=OneWay}"/>
                </Grid>

                <!-- Status text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.ChargeDetailText, Mode=OneWay}"
                               FontSize="10"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Row 1: Progress bar -->
            <ProgressBar Grid.Row="1"
                          Value="{x:Bind ViewModel.ChargePercent, Mode=OneWay}"
                          Minimum="0"
                          Maximum="100"
                          Height="4"
                          Margin="0,0,0,8"
                          Foreground="{ThemeResource AccentBrush}" />

            <!-- Row 2: Percentage label -->
            <TextBlock Grid.Row="2"
                       Text="{x:Bind ViewModel.ChargePercentText, Mode=OneWay}"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{ThemeResource AccentBrush}"
                       TextAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
