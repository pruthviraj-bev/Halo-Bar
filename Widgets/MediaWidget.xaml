<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DynamicIsland.Widgets.MediaWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:DynamicIsland.Helpers"
    xmlns:controls="using:DynamicIsland.Controls"
    SizeChanged="UserControl_SizeChanged"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <helpers:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter" />
        <helpers:PlayPauseIconConverter x:Key="PlayPauseIconConverter" />

        <!-- Premium Win11 Button Style with hover & pressed animations -->
        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootLayout" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <!-- Collapsed State Layout -->
                <VisualState x:Name="CollapsedState">
                    <VisualState.Setters>
                        <Setter Target="CollapsedGrid.Visibility" Value="Visible" />
                        <Setter Target="ExpandedGrid.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <!-- Expanded State Layout -->
                <VisualState x:Name="ExpandedState">
                    <VisualState.Setters>
                        <Setter Target="CollapsedGrid.Visibility" Value="Collapsed" />
                        <Setter Target="ExpandedGrid.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 1. Collapsed View (Taskbar Capsule style - Auto-sized Columns) -->
        <Grid x:Name="CollapsedGrid" 
              Visibility="Visible" 
              ColumnDefinitions="Auto, *, Auto, Auto" 
              VerticalAlignment="Center">
            
            <!-- Col 0: Album Art (Large circular art matching pill height) -->
            <Grid Grid.Column="0" 
                  Width="38" Height="38" 
                  CornerRadius="19" 
                  Background="#15FFFFFF" 
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Center"
                  Margin="0,0,8,0">
                <Image Source="{x:Bind ViewModel.Thumbnail, Mode=OneWay}" 
                       Visibility="{x:Bind ViewModel.Thumbnail, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}" 
                       Stretch="UniformToFill" />
                <controls:AppIcon Kind="MusicNote" Width="12" Height="12"
                                  Fill="{ThemeResource TextSecondaryBrush}"
                                  Visibility="{x:Bind ViewModel.Thumbnail, Converter={StaticResource NullToVisibilityInverseConverter}, Mode=OneWay}" />
            </Grid>

            <!-- Col 1: Song Information (Auto-stretched width) -->
            <StackPanel Grid.Column="1" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Stretch" 
                        Margin="4,0,8,0">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                        <AddDeleteThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- Title -->
                <TextBlock x:Name="SongTitleTextBlock"
                           FontSize="10.5" 
                           FontWeight="SemiBold" 
                           Foreground="{ThemeResource TextPrimaryBrush}" 
                           TextTrimming="CharacterEllipsis" 
                           VerticalAlignment="Center">
                    <Run Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                </TextBlock>

                <!-- Artist -->
                <TextBlock x:Name="SongArtistTextBlock"
                           FontSize="8.5" 
                           Foreground="{ThemeResource TextSecondaryBrush}" 
                           Opacity="0.7" 
                           TextTrimming="CharacterEllipsis" 
                           VerticalAlignment="Center"
                           Margin="0,2,0,0">
                    <Run Text="{x:Bind ViewModel.Artist, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <!-- Col 2: 5-bar Waveform Indicator representing playing oscillation and progress coloring -->
            <!-- Positioned in its own column so it remains always visible, never clips, and never jumps vertically -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal" 
                        Spacing="2.5" 
                        Height="14" 
                        Margin="0,0,8,0" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                <Border x:Name="WBar0" Width="2.5" Height="6" CornerRadius="1.25" Background="#15FFFFFF" VerticalAlignment="Center"/>
                <Border x:Name="WBar1" Width="2.5" Height="10" CornerRadius="1.25" Background="#15FFFFFF" VerticalAlignment="Center"/>
                <Border x:Name="WBar2" Width="2.5" Height="5" CornerRadius="1.25" Background="#15FFFFFF" VerticalAlignment="Center"/>
                <Border x:Name="WBar3" Width="2.5" Height="12" CornerRadius="1.25" Background="#15FFFFFF" VerticalAlignment="Center"/>
                <Border x:Name="WBar4" Width="2.5" Height="8" CornerRadius="1.25" Background="#15FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Col 3: Media Controls (Symmetric layout, no right-hand padding) -->
            <StackPanel Grid.Column="3" 
                        Orientation="Horizontal" 
                        Spacing="8" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center">
                <Button Style="{StaticResource PlayerButtonStyle}" Command="{x:Bind ViewModel.PreviousCommand}" ToolTipService.ToolTip="Previous">
                    <controls:AppIcon Kind="Previous" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource PlayerButtonStyle}" Command="{x:Bind ViewModel.PlayPauseCommand}" ToolTipService.ToolTip="Play/Pause">
                    <controls:AppIcon Kind="{x:Bind ViewModel.IsPlaying, Converter={StaticResource PlayPauseIconConverter}, Mode=OneWay}" Filled="True" Width="20" Height="20"/>
                </Button>
                <Button Style="{StaticResource PlayerButtonStyle}" Command="{x:Bind ViewModel.NextCommand}" ToolTipService.ToolTip="Next">
                    <controls:AppIcon Kind="Next" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Expanded View (redundant now but kept for compatibility) -->
        <Grid x:Name="ExpandedGrid" Visibility="Collapsed" RowDefinitions="Auto,Auto" VerticalAlignment="Stretch">
            <!-- Upper Row: Album Art + Track Meta -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,0,4">
                <Grid Grid.Column="0" Width="40" Height="40" CornerRadius="6" Background="#15FFFFFF" Margin="0,0,10,0">
                    <Image Source="{x:Bind ViewModel.Thumbnail, Mode=OneWay}" 
                           Visibility="{x:Bind ViewModel.Thumbnail, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}" 
                           Stretch="UniformToFill" />
                    <controls:AppIcon Kind="MusicNote" Width="20" Height="20"
                                      Fill="{ThemeResource TextSecondaryBrush}"
                                      Visibility="{x:Bind ViewModel.Thumbnail, Converter={StaticResource NullToVisibilityInverseConverter}, Mode=OneWay}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" 
                               FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" 
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                    <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}" 
                               FontSize="10.5" Foreground="{ThemeResource TextSecondaryBrush}" 
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Lower Row: Playback Keys -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <Button Style="{StaticResource PlayerButtonStyle}" Width="36" Height="36" CornerRadius="18" Command="{x:Bind ViewModel.PreviousCommand}">
                    <controls:AppIcon Kind="Previous" Width="20" Height="20"/>
                </Button>
                <Button Style="{StaticResource PlayerButtonStyle}" Width="36" Height="36" CornerRadius="18" Command="{x:Bind ViewModel.PlayPauseCommand}">
                    <controls:AppIcon Kind="{x:Bind ViewModel.IsPlaying, Converter={StaticResource PlayPauseIconConverter}, Mode=OneWay}" Filled="True" Width="24" Height="24"/>
                </Button>
                <Button Style="{StaticResource PlayerButtonStyle}" Width="36" Height="36" CornerRadius="18" Command="{x:Bind ViewModel.NextCommand}">
                    <controls:AppIcon Kind="Next" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
