<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DynamicIsland.Widgets.ExpandedDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:DynamicIsland.Helpers"
    xmlns:local="using:DynamicIsland.Widgets"
    xmlns:models="using:DynamicIsland.Models"
    xmlns:services="using:DynamicIsland.Services"
    xmlns:controls="using:DynamicIsland.Controls"
    mc:Ignorable="d"
    Width="780"
    Height="640">

    <!-- Resources -->
    <UserControl.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <helpers:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter" />
        <helpers:FocusProgressToArcConverter x:Key="FocusProgressToArcConverter" />
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Button styles inside cards -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Play/Pause circle button using Accent color -->
        <Style x:Key="PlayCircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Clipboard list converters -->
        <helpers:ClipboardImagePathConverter x:Key="ClipboardImagePathConverter" />
        <helpers:ClipboardTypeIconConverter x:Key="ClipboardTypeIconConverter" />
        <helpers:IsPinnedToIconConverter x:Key="IsPinnedToIconConverter" />
        <helpers:IsPinnedToBrushConverter x:Key="IsPinnedToBrushConverter" />

        <!-- All/Pinned filter toggle buttons -->
        <Style x:Key="FilterToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootLayoutGrid">
        <!-- Home icon top‑left -->
        <controls:AppIcon Kind="Home" Width="20" Height="20"
                          Fill="{ThemeResource TextSecondaryBrush}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" />

        <!-- Dummy elements to satisfy code-behind references and build -->
        <Canvas Visibility="Collapsed">
            <Polyline x:Name="CpuGraphLine" />
            <Polyline x:Name="GpuGraphLine" />
        </Canvas>

        <!-- Main layout grid -->
        <Grid RowSpacing="0" Margin="8,40,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="320"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        <!-- Unified top area – left column: Stats + Focus Session, right column: Clipboard -->
        <Grid Grid.Row="0" RowDefinitions="*" ColumnDefinitions="2*,3*" RowSpacing="8" ColumnSpacing="8">
            <!-- LEFT column – resources grid (top) + Focus Session (fills remaining height) -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="12">
                <!-- 2×2 resource placeholder grid -->
                <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="4">
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="8"><TextBlock Text="RAM" HorizontalAlignment="Center" /></Border>
                    <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="8"><TextBlock Text="CPU" HorizontalAlignment="Center" /></Border>
                    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="8"><TextBlock Text="GPU" HorizontalAlignment="Center" /></Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="8"><TextBlock Text="DISK" HorizontalAlignment="Center" /></Border>
                </Grid>

                <!-- Focus Session card – shared WidgetCard shell; stretches to fill remaining left-column height. -->
                <controls:WidgetCard Grid.Row="1" IsTabStop="False">
                    <controls:WidgetCard.HeaderContent>
                        <!-- Main/settings header pair: in-place Visibility swap (deliberate design; not the overlay slot). -->
                        <Grid>
                            <StackPanel x:Name="FocusMainHeader" Orientation="Horizontal" Spacing="6">
                                <controls:AppIcon Kind="Target" Width="12" Height="12" Fill="{ThemeResource AccentBrush}"/>
                                <TextBlock Text="FOCUS SESSION" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" CharacterSpacing="50"/>
                            </StackPanel>
                            <Grid x:Name="FocusSettingsHeader" Visibility="Collapsed" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Grid.Column="0" Text="{x:Bind FocusSettingsHeaderText, Mode=OneWay}" FontSize="10" FontWeight="Bold"
                                           Foreground="{ThemeResource TextSecondaryBrush}" CharacterSpacing="50" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource CardButtonStyle}"
                                        Click="FocusSettingsClose_Click" ToolTipService.ToolTip="Close" HorizontalAlignment="Right">
                                    <controls:AppIcon Kind="Dismiss" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </controls:WidgetCard.HeaderContent>
                    <controls:WidgetCard.BodyContent>
                        <Grid>
                            <StackPanel x:Name="FocusMainBody" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                <TextBlock Text="{x:Bind CurrentSessionName, Mode=OneWay}" FontSize="10" FontWeight="Bold"
                                           Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <Grid x:Name="FocusRingGrid" Width="100" Height="100">
                                    <Ellipse Stroke="Gray" StrokeThickness="4" />
                                    <Path Data="{x:Bind FocusProgressFraction, Converter={StaticResource FocusProgressToArcConverter}, Mode=OneWay}" Stroke="{ThemeResource AccentBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <!-- Pill handle wrapper: rotates about the ring center; pill sits at 12 o'clock (Angle 0). -->
                                    <Grid Width="100" Height="100" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="FocusPillRotate" Angle="0" />
                                        </Grid.RenderTransform>
                                        <Ellipse Width="14" Height="14" Fill="{ThemeResource AccentBrush}" Stroke="White" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind FocusTimerText, Mode=OneWay}" Style="{StaticResource Type.LargeNumber}" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- Transparent drag surface: full-ring hit target, topmost. -->
                                    <Ellipse Fill="Transparent" x:Name="FocusRingDragSurface"
                                             PointerPressed="FocusRing_PointerPressed"
                                             PointerMoved="FocusRing_PointerMoved"
                                             PointerReleased="FocusRing_PointerReleased"
                                             PointerCanceled="FocusRing_PointerCanceled"
                                             PointerCaptureLost="FocusRing_PointerCaptureLost" />
                                </Grid>
                                <ItemsControl x:Name="FocusDotsControl"
                                              ItemsSource="{x:Bind FocusSessions}"
                                              HorizontalAlignment="Center"
                                              Loaded="FocusDotsControl_Loaded">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.XS}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FocusSession">
                                            <Button Background="Transparent" BorderThickness="0" Padding="2"
                                                    Click="FocusSessionDot_Click"
                                                    ToolTipService.ToolTip="{x:Bind Name}">
                                                <Ellipse x:Name="DotEllipse" Width="6" Height="6" Fill="LightGray" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource CardButtonStyle}" Width="16" Height="16"
                                        Click="FocusSessionAdd_Click" ToolTipService.ToolTip="New session">
                                    <controls:AppIcon Kind="Add" Width="12" Height="12"/>
                                </Button>
                            </StackPanel>
                            <StackPanel x:Name="FocusSettingsBody" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="10">
                                <TextBox x:Name="FocusSettingsNameBox" PlaceholderText="Session name" FontSize="12" MaxLength="40"/>
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="FocusSettingsReadout" Text="25:00" Style="{StaticResource Type.LargeNumber}"
                                               Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Duration (minutes)" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <NumberBox x:Name="FocusSettingsHoursBox" Minimum="0" Maximum="23" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="FocusSettingsNumberBox_ValueChanged"/>
                                        <TextBlock Text="H" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <NumberBox x:Name="FocusSettingsMinutesBox" Minimum="0" Maximum="59" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="FocusSettingsNumberBox_ValueChanged"/>
                                        <TextBlock Text="M" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <NumberBox x:Name="FocusSettingsSecondsBox" Minimum="0" Maximum="59" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="FocusSettingsNumberBox_ValueChanged"/>
                                        <TextBlock Text="S" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </controls:WidgetCard.BodyContent>
                    <controls:WidgetCard.FooterContent>
                        <Grid>
                            <StackPanel x:Name="FocusMainFooter" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource Spacing.M}">
                                <Button Style="{StaticResource PlayCircleButtonStyle}"
                                        Click="FocusPlayPause_Click" ToolTipService.ToolTip="Start/Pause">
                                    <controls:AppIcon Kind="{x:Bind FocusPlayPauseIconKind, Mode=OneWay}" Filled="True"
                                                      Width="20" Height="20" Fill="White"/>
                                </Button>
                                <Button Style="{StaticResource CardButtonStyle}"
                                        Click="FocusReset_Click" ToolTipService.ToolTip="Reset">
                                    <controls:AppIcon Kind="Reset" Width="16" Height="16"/>
                                </Button>
                                <Button Style="{StaticResource CardButtonStyle}"
                                        Click="FocusSettings_Click" ToolTipService.ToolTip="Settings">
                                    <controls:AppIcon Kind="Settings" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                            <StackPanel x:Name="FocusSettingsFooter" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource Spacing.M}" Margin="0,8,0,0">
                                <Button Style="{StaticResource PlayCircleButtonStyle}"
                                        Click="FocusSettingsSave_Click" ToolTipService.ToolTip="Save">
                                    <controls:AppIcon Kind="Save" Filled="True" Width="20" Height="20" Fill="White"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </controls:WidgetCard.FooterContent>
                </controls:WidgetCard>
            </Grid>

            <!-- RIGHT column – real clipboard history -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="6" VerticalAlignment="Stretch">
                <!-- Header row: title + All/Pinned filter toggle -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="Clipboard" FontSize="14" FontWeight="Bold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" Spacing="4">
                        <Button x:Name="AllFilterButton" Style="{StaticResource FilterToggleButtonStyle}" Content="All" Click="AllFilter_Click" />
                        <Button x:Name="PinnedFilterButton" Style="{StaticResource FilterToggleButtonStyle}" Content="Pinned" Click="PinnedFilter_Click" />
                    </StackPanel>
                </Grid>

                <!-- Empty state -->
                <TextBlock Grid.Row="1" x:Name="ClipboardEmptyText" Text="Nothing copied yet" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{x:Bind ClipboardEmptyVisibility, Mode=OneWay}" />

                <ScrollViewer Grid.Row="2" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <ItemsControl ItemsSource="{x:Bind ClipboardItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:ClipboardItem">
                                <Grid>
                                    <!-- Background delete strip, revealed by sliding the front card left -->
                                    <Button Background="#E81123" Foreground="White" BorderThickness="0"
                                            CornerRadius="6" Width="56" Height="Auto" Padding="0"
                                            Opacity="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                            Margin="0,0,0,4"
                                            Click="ClipboardRevealedDelete_Click" Tapped="ClipboardAction_Tapped"
                                            ToolTipService.ToolTip="Delete">
                                        <controls:AppIcon Kind="Delete" Width="20" Height="20" Fill="White"/>
                                    </Button>

                                    <!-- Front card -->
                                    <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,4"
                                            Background="Transparent"
                                            Tapped="ClipboardItemCard_Tapped">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="FrontCardTranslate" X="0" Y="0" />
                                        </Border.RenderTransform>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <!-- Thumbnail / type glyph (64x64) -->
                                            <Grid Grid.Column="0" Width="64" Height="64" CornerRadius="6" Background="#12FFFFFF" VerticalAlignment="Center">
                                                <Image Source="{x:Bind ImageFilePath, Converter={StaticResource ClipboardImagePathConverter}, Mode=OneWay}"
                                                       Visibility="{x:Bind ImageFilePath, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"
                                                       Stretch="UniformToFill" />
                                                <controls:AppIcon Kind="{x:Bind Type, Converter={StaticResource ClipboardTypeIconConverter}, Mode=OneWay}"
                                                                  Width="16" Height="16"
                                                                  Fill="{ThemeResource AccentBrush}"
                                                                  Visibility="{x:Bind ImageFilePath, Converter={StaticResource NullToVisibilityInverseConverter}, Mode=OneWay}" />
                                            </Grid>

                                            <!-- Title / content text -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="9.5" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            </StackPanel>

                                            <!-- Pin + More stacked vertically in the trailing slot -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                                <Button Style="{StaticResource CardButtonStyle}"
                                                        Click="ClipboardMore_Click" Tapped="ClipboardAction_Tapped"
                                                        ToolTipService.ToolTip="More">
                                                    <controls:AppIcon Kind="More" Width="16" Height="16"/>
                                                </Button>
                                                <Button Style="{StaticResource CardButtonStyle}"
                                                        Click="ClipboardPin_Click" Tapped="ClipboardAction_Tapped"
                                                        ToolTipService.ToolTip="Pin/Unpin">
                                                    <controls:AppIcon Kind="{x:Bind IsPinned, Converter={StaticResource IsPinnedToIconConverter}, Mode=OneWay}"
                                                                      Filled="{x:Bind IsPinned, Mode=OneWay}"
                                                                      Fill="{x:Bind IsPinned, Converter={StaticResource IsPinnedToBrushConverter}, Mode=OneWay}"
                                                                      Width="16" Height="16"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Now Playing (original content wrapped in outline) -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="0">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <controls:AppIcon Kind="MusicNote" Width="12" Height="12" Fill="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" CharacterSpacing="50"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Style="{StaticResource CardButtonStyle}" Command="{x:Bind MediaViewModel.PreviousSourceCommand}" IsEnabled="{x:Bind MediaViewModel.HasMultipleSources, Mode=OneWay}" ToolTipService.ToolTip="Previous source">
                            <controls:AppIcon Kind="Previous" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource CardButtonStyle}" Command="{x:Bind MediaViewModel.NextSourceCommand}" IsEnabled="{x:Bind MediaViewModel.HasMultipleSources, Mode=OneWay}" ToolTipService.ToolTip="Next source">
                            <controls:AppIcon Kind="Next" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <Grid Grid.Column="0" Width="64" Height="64" CornerRadius="8" Background="#15FFFFFF" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Image Source="{x:Bind MediaViewModel.Thumbnail, Mode=OneWay}" Visibility="{x:Bind MediaViewModel.Thumbnail, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}" Stretch="UniformToFill" />
                        <controls:AppIcon Kind="MusicNote" Width="20" Height="20"
                                          Fill="{ThemeResource TextSecondaryBrush}"
                                          Visibility="{x:Bind MediaViewModel.Thumbnail, Converter={StaticResource NullToVisibilityInverseConverter}, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,-4,0,0">
                        <TextBlock Text="{x:Bind MediaViewModel.Title, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind MediaViewModel.Artist, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="{x:Bind CurrentPlaybackTimeText, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <Slider x:Name="PlaybackSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind PlaybackProgressValue, Mode=OneWay}" Background="#15FFFFFF" Foreground="{ThemeResource AccentBrush}" Margin="8,0,8,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsThumbToolTipEnabled="False" ValueChanged="PlaybackSlider_ValueChanged">
                                <Slider.Resources>
                                    <x:Double x:Key="SliderTrackThemeHeight">2.5</x:Double>
                                    <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
                                    <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
                                    <x:Double x:Key="SliderInnerThumbWidth">8</x:Double>
                                    <x:Double x:Key="SliderInnerThumbHeight">8</x:Double>
                                </Slider.Resources>
                            </Slider>
                            <TextBlock Grid.Column="2" Text="{x:Bind TotalPlaybackTimeText, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,2,0,0" VerticalAlignment="Center">
                    <Button Grid.Column="0" x:Name="RepeatButton" Style="{StaticResource CardButtonStyle}" Command="{x:Bind MediaViewModel.ToggleRepeatCommand}" ToolTipService.ToolTip="Repeat">
                        <controls:AppIcon Kind="Repeat" Width="16" Height="16"/>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource CardButtonStyle}" Command="{x:Bind MediaViewModel.PreviousCommand}" ToolTipService.ToolTip="Previous">
                        <controls:AppIcon Kind="Previous" Width="16" Height="16"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource PlayCircleButtonStyle}" Command="{x:Bind MediaViewModel.PlayPauseCommand}" Margin="8,0,8,0" ToolTipService.ToolTip="Play/Pause">
                        <controls:AppIcon Kind="{x:Bind MediaViewModel.IsPlaying, Converter={StaticResource PlayPauseIconConverter}, Mode=OneWay}" Filled="True"
                                          Width="20" Height="20" Fill="White"/>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource CardButtonStyle}" Command="{x:Bind MediaViewModel.NextCommand}" ToolTipService.ToolTip="Next">
                        <controls:AppIcon Kind="Next" Width="16" Height="16"/>
                    </Button>
                    <Grid Grid.Column="5" ColumnDefinitions="Auto,*" Width="120" VerticalAlignment="Center">
                        <Button Grid.Column="0" Style="{StaticResource CardButtonStyle}" Width="28" Height="28" Click="MuteButton_Click" ToolTipService.ToolTip="Mute/Unmute">
                            <controls:AppIcon Kind="Speaker1" Width="14" Height="14"/>
                        </Button>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind VolumePercentValue, Mode=TwoWay}" Margin="4,0,0,0" Height="20" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer strip -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Height="30" Margin="0,8,0,0">
            <TextBlock Text="31°C" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <controls:AppIcon Kind="Settings" Width="16" Height="16"
                              Fill="{ThemeResource TextSecondaryBrush}"
                              VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
        </Grid>
    </Grid>
</Grid>
</UserControl>
