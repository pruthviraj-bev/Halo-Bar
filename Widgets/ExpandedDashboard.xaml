<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DynamicIsland.Widgets.ExpandedDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:DynamicIsland.Helpers"
    xmlns:local="using:DynamicIsland.Widgets"
    mc:Ignorable="d"
    Width="780"
    Height="460">

    <UserControl.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <helpers:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter" />
        <helpers:PlaybackGlyphConverter x:Key="PlaybackGlyphConverter" />
        <helpers:PlayPauseGlyphConverter x:Key="PlayPauseGlyphConverter" />


        <!-- 8px Baseline Grid Section Border Style (No Card backgrounds, e.g. seamless glass) -->
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#15FFFFFF" /> <!-- Hairline divider at 8% opacity -->
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Button styles inside cards (using unified Segoe Fluent Icons) -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Play/Pause circle button using Accent color -->
        <Style x:Key="PlayCircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Bluetooth device connect/disconnect toggle -->
        <Style x:Key="BtToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Resources>

    <Grid RowDefinitions="160,210,90" RowSpacing="0">
        <!-- Row 0: Now Playing (Left) & Clipboard (Right) -->
        <Grid Grid.Row="0" ColumnDefinitions="1.3*,1*" ColumnSpacing="0">
            <!-- Now Playing Card -->
            <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,1,1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6" Spacing="6">
                        <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="12.5" Foreground="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" CharacterSpacing="50"/>
                    </StackPanel>

                    <!-- Content (Art + Metadata) -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <!-- Art -->
                        <Grid Grid.Column="0" Width="64" Height="64" CornerRadius="8" Background="#15FFFFFF" Margin="0,0,14,0" VerticalAlignment="Top">
                            <Image Source="{x:Bind MediaViewModel.Thumbnail, Mode=OneWay}" 
                                   Visibility="{x:Bind MediaViewModel.Thumbnail, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}" 
                                   Stretch="UniformToFill" />
                            <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="20" 
                                      Foreground="{ThemeResource TextSecondaryBrush}"
                                      Visibility="{x:Bind MediaViewModel.Thumbnail, Converter={StaticResource NullToVisibilityInverseConverter}, Mode=OneWay}" />
                        </Grid>

                        <!-- Track Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,-4,0,0">
                            <TextBlock Text="{x:Bind MediaViewModel.Title, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind MediaViewModel.Artist, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                            
                            <!-- Track Slider & Progress line -->
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="{x:Bind CurrentPlaybackTimeText, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <ProgressBar Grid.Column="1" 
                                             Value="{x:Bind PlaybackProgressValue, Mode=OneWay}" 
                                             Minimum="0" Maximum="100" 
                                             Height="2.5" 
                                             Foreground="{ThemeResource AccentBrush}" 
                                             Background="#15FFFFFF" 
                                             CornerRadius="1.25" 
                                             Margin="8,0,8,0" 
                                             HorizontalAlignment="Stretch" 
                                             VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind TotalPlaybackTimeText, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Controls -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,2,0,0" VerticalAlignment="Center">
                        <Button Grid.Column="0" Style="{StaticResource CardButtonStyle}" Content="&#xE892;" Command="{x:Bind MediaViewModel.PreviousCommand}" ToolTipService.ToolTip="Previous" />
                        <Button Grid.Column="1" Style="{StaticResource PlayCircleButtonStyle}" Content="{x:Bind MediaViewModel.IsPlaying, Converter={StaticResource PlayPauseGlyphConverter}, Mode=OneWay}" Command="{x:Bind MediaViewModel.PlayPauseCommand}" Margin="8,0,8,0" ToolTipService.ToolTip="Play/Pause" />
                        <Button Grid.Column="2" Style="{StaticResource CardButtonStyle}" Content="&#xE893;" Command="{x:Bind MediaViewModel.NextCommand}" ToolTipService.ToolTip="Next" />
                        
                        <!-- Volume Slider -->
                        <Grid Grid.Column="4" ColumnDefinitions="Auto,*" Width="120" VerticalAlignment="Center">
                            <Button Grid.Column="0" Style="{StaticResource CardButtonStyle}" Width="28" Height="28" Content="&#xE767;" Click="MuteButton_Click" ToolTipService.ToolTip="Mute/Unmute"/>
                            <Slider Grid.Column="1" 
                                    Minimum="0" 
                                    Maximum="100" 
                                    Value="{x:Bind VolumePercentValue, Mode=TwoWay}" 
                                    Margin="4,0,0,0" 
                                    Height="20"
                                    Foreground="{ThemeResource AccentBrush}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Clipboard Card -->
            <Border Grid.Column="1" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF0E3;" FontFamily="Segoe Fluent Icons" FontSize="12.5" Foreground="{ThemeResource AccentBrush}"/>
                            <TextBlock Text="CLIPBOARD" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" CharacterSpacing="50"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{ThemeResource AccentBrush}" FontSize="10" FontWeight="SemiBold" Click="ClearAllClipboard_Click"/>
                    </Grid>

                    <!-- History Items List -->
                    <StackPanel Grid.Row="1" Spacing="5" VerticalAlignment="Center">
                        <!-- Item 1 (Live Current Item) -->
                        <Grid ColumnDefinitions="*,Auto" Height="26" Background="#0AFFFFFF" Padding="8,2" CornerRadius="6">
                            <TextBlock Grid.Column="0" Text="{x:Bind LiveClipboardTitle, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="9.5" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Item 2 (Mock History) -->
                        <Grid ColumnDefinitions="*,Auto" Height="26" Background="#05FFFFFF" Padding="8,2" CornerRadius="6">
                            <TextBlock Grid.Column="0" Text="git clone https://github.com/dynowin" FontSize="10.5" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="9.5" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Paste Actions Button -->
                    <Grid Grid.Row="2" Margin="0,2,0,0">
                        <Button Content="Paste Active" Background="#FF2D2D30" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" FontSize="11" Height="28" HorizontalAlignment="Stretch" Click="PasteClipboard_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 1: Focus Session (Left), Quick Tasks (Middle), File Shelf (Right) -->
        <Grid Grid.Row="1" ColumnDefinitions="1*,1*,1*" ColumnSpacing="0">
            <!-- Focus Session Card -->
            <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,1,1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6" Spacing="6">
                        <FontIcon Glyph="&#xE815;" FontFamily="Segoe Fluent Icons" FontSize="12.5" Foreground="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="FOCUS SESSION" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" CharacterSpacing="50"/>
                    </StackPanel>

                    <!-- Timer Count -->
                    <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind FocusTimerText, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </Grid>

                    <!-- Controls -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <Button Style="{StaticResource PlayCircleButtonStyle}" Content="{x:Bind FocusPlayPauseGlyph, Mode=OneWay}" Click="FocusPlayPause_Click" ToolTipService.ToolTip="Start/Pause" />
                        <Button Style="{StaticResource CardButtonStyle}" Content="&#xE777;" Click="FocusReset_Click" ToolTipService.ToolTip="Reset" />
                    </StackPanel>

                    <!-- Round Info (floating on top of grid row 2) -->
                    <TextBlock Grid.Row="2" Text="{x:Bind FocusRoundText, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-40"/>
                </Grid>
            </Border>

            <!-- Quick Tasks Card -->
            <Border Grid.Column="1" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,1,1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6" Spacing="6">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12.5" Foreground="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="QUICK TASKS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" CharacterSpacing="50"/>
                    </StackPanel>

                    <!-- List of Tasks -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,2,0,4">
                        <ItemsControl ItemsSource="{x:Bind Tasks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TaskItem">
                                    <Grid Margin="0,2">
                                        <!-- Custom Styled CheckBox with Purple Accent -->
                                        <CheckBox IsChecked="{x:Bind IsCompleted, Mode=OneWay}" 
                                                  Checked="Task_Checked" 
                                                  Unchecked="Task_Unchecked" 
                                                  Content="{x:Bind Text, Mode=OneWay}" 
                                                  FontSize="11.5" 
                                                  Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add task input -->
                    <TextBox Grid.Row="2" 
                             PlaceholderText="+ Add task..." 
                             FontSize="11" 
                             Height="28" 
                             Background="#0AFFFFFF" 
                             BorderBrush="#15FFFFFF" 
                             BorderThickness="1" 
                             CornerRadius="6"
                             Padding="8,2"
                             KeyDown="AddTaskTextBox_KeyDown"/>
                </Grid>
            </Border>

            <!-- File Shelf Card -->
            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6" Spacing="6">
                        <FontIcon Glyph="&#xE8F4;" FontFamily="Segoe Fluent Icons" FontSize="12.5" Foreground="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="FILE SHELF" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" CharacterSpacing="50"/>
                    </StackPanel>

                    <!-- Drop Zone / Stash list -->
                    <Border Grid.Row="1" 
                            x:Name="FileDropZone" 
                            AllowDrop="True" 
                            DragOver="FileDropZone_DragOver" 
                            Drop="FileDropZone_Drop"
                            BorderBrush="#33FFFFFF" 
                            BorderThickness="1.5" 
                            CornerRadius="8" 
                            Background="#08FFFFFF" 
                            Padding="8"
                            Margin="0,2,0,4">
                        <Grid>
                            <!-- Drop Zone Text (shows only when list is empty) -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" 
                                        Visibility="{x:Bind DropZoneVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE898;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Text="Drop to stash" FontSize="10.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Stashed items (scrollable list) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind StashedFilesVisibility, Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind StashedFiles, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:StashedFile">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Height="26" Background="#15FFFFFF" Padding="6,2" CornerRadius="6" Margin="0,1">
                                                <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" 
                                                        Content="{x:Bind Name}" 
                                                        Tag="{x:Bind Path}" 
                                                        Click="StashedFile_Click" 
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Padding="0" 
                                                        FontSize="10.5" 
                                                        Foreground="{ThemeResource TextPrimaryBrush}" 
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Left" 
                                                        VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" 
                                                        Tag="{x:Bind Path}" 
                                                        Click="DeleteStashedFile_Click" 
                                                        Style="{StaticResource CardButtonStyle}" 
                                                        Width="20" Height="20" FontSize="8" 
                                                        Content="&#xE711;" 
                                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Bottom Stats Row (Weather, CPU, RAM, GPU, Disk) - 5 columns seamless -->
        <Grid Grid.Row="2" ColumnDefinitions="1.2*,1*,1*,1*,1*" ColumnSpacing="0">
            <!-- Weather Card -->
            <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,1,0" Padding="12,10">
                <Grid>
                    <!-- Unavailable state -->
                    <Grid Visibility="{x:Bind WeatherUnavailableVisibility, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Weather Unavailable" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" Opacity="0.7"/>
                    </Grid>

                    <!-- Real Weather Data -->
                    <Grid RowDefinitions="*,Auto" Visibility="{x:Bind WeatherAvailableVisibility, Mode=OneWay}">
                        <!-- Top Details -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <FontIcon Grid.Column="0" Glyph="{x:Bind WeatherGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FFFFD700" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind WeatherTemp, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,-2,0,0"/>
                                <TextBlock Text="Seattle" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Compact 3-day forecast text -->
                        <TextBlock Grid.Row="1" FontSize="8.5" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,2,0,-4">
                            <Run Text="M: "/>
                            <Run Text="{x:Bind ForecastDay1Temp, Mode=OneWay}" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <Run Text="  T: "/>
                            <Run Text="{x:Bind ForecastDay2Temp, Mode=OneWay}" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <Run Text="  W: "/>
                            <Run Text="{x:Bind ForecastDay3Temp, Mode=OneWay}" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- CPU Card -->
            <Border Grid.Column="1" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,1,0" Padding="12,10">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="CPU" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind CpuPercentText, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Canvas Grid.Row="1" x:Name="CpuGraphCanvas" Height="22" Margin="0,4,0,0" VerticalAlignment="Center">
                        <Polyline x:Name="CpuGraphLine" Stroke="{ThemeResource AccentBrush}" StrokeThickness="1.2"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- RAM Card -->
            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,1,0" Padding="12,10">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="RAM" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind RamPercentText, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" FontSize="8" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,-2,0,0">
                        <Run Text="{x:Bind RamUsedText, Mode=OneWay}"/>
                    </TextBlock>
                    <ProgressBar Grid.Row="2" Value="{x:Bind RamPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="2.5" Foreground="{ThemeResource AccentBrush}" Background="#20FFFFFF" CornerRadius="1.25"/>
                </Grid>
            </Border>

            <!-- GPU Card -->
            <Border Grid.Column="3" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,1,0" Padding="12,10">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="GPU" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind GpuPercentText, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Canvas Grid.Row="1" x:Name="GpuGraphCanvas" Height="22" Margin="0,4,0,0" VerticalAlignment="Center">
                        <Polyline x:Name="GpuGraphLine" Stroke="{ThemeResource AccentBrush}" StrokeThickness="1.2"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Disk Card -->
            <Border Grid.Column="4" Style="{StaticResource SectionBorderStyle}" BorderThickness="0" Padding="12,10">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="DISK" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind StoragePercentText, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" FontSize="8" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,-2,0,0">
                        <Run Text="{x:Bind StorageFreeText, Mode=OneWay}"/>
                        <Run Text=" free"/>
                    </TextBlock>
                    <ProgressBar Grid.Row="2" Value="{x:Bind StoragePercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="2.5" Foreground="{ThemeResource AccentBrush}" Background="#20FFFFFF" CornerRadius="1.25"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
