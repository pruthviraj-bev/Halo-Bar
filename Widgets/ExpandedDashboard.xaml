<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DynamicIsland.Widgets.ExpandedDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:DynamicIsland.Helpers"
    xmlns:local="using:DynamicIsland.Widgets"
    mc:Ignorable="d"
    Width="780"
    Height="460">

    <UserControl.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <helpers:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter" />
        <helpers:PlaybackGlyphConverter x:Key="PlaybackGlyphConverter" />
        <helpers:PlayPauseGlyphConverter x:Key="PlayPauseGlyphConverter" />

        <!-- Pulse animation storyboard for charging bolt -->
        <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="BatteryChargingBoltDashboard"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.6" Duration="0:0:1"
                             AutoReverse="True"/>
        </Storyboard>

        <!-- 8px Baseline Grid Section Border Style (No Card backgrounds, e.g. seamless glass) -->
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#15FFFFFF" /> <!-- Hairline divider at 8% opacity -->
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Button styles inside cards (using unified Segoe Fluent Icons) -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Play/Pause circle button using Accent color -->
        <Style x:Key="PlayCircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Bluetooth device connect/disconnect toggle -->
        <Style x:Key="BtToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Resources>

    <Grid RowDefinitions="180,180,100" RowSpacing="0">
        <!-- Row 0: Now Playing (Left) & Clipboard (Right) -->
        <Grid Grid.Row="0" ColumnDefinitions="1.25*,1*" ColumnSpacing="0">
            <!-- Now Playing Card -->
            <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,1,1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" Spacing="6">
                        <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="12.5" Foreground="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="Now Playing" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Content (Art + Metadata) -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <!-- Art -->
                        <Grid Grid.Column="0" Width="68" Height="68" CornerRadius="8" Background="#15FFFFFF" Margin="0,0,14,0" VerticalAlignment="Top">
                            <Image Source="{x:Bind MediaViewModel.Thumbnail, Mode=OneWay}" 
                                   Visibility="{x:Bind MediaViewModel.Thumbnail, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}" 
                                   Stretch="UniformToFill" />
                            <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="22" 
                                      Foreground="{ThemeResource TextSecondaryBrush}"
                                      Visibility="{x:Bind MediaViewModel.Thumbnail, Converter={StaticResource NullToVisibilityInverseConverter}, Mode=OneWay}" />
                        </Grid>

                        <!-- Track Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind MediaViewModel.Title, Mode=OneWay}" FontSize="14.5" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind MediaViewModel.Artist, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                            
                            <!-- Track Slider & Progress line -->
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,2">
                                <TextBlock Grid.Column="0" Text="{x:Bind CurrentPlaybackTimeText, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                
                                <!-- Subtle Thin Fluent progress line (matching collapsed pill) -->
                                <ProgressBar Grid.Column="1" 
                                             Value="{x:Bind PlaybackProgressValue, Mode=OneWay}" 
                                             Minimum="0" Maximum="100" 
                                             Height="1.5" 
                                             Foreground="{ThemeResource AccentBrush}" 
                                             Background="#15FFFFFF" 
                                             CornerRadius="0.75" 
                                             Margin="8,0,8,0" 
                                             HorizontalAlignment="Stretch" 
                                             VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2" Text="{x:Bind TotalPlaybackTimeText, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Controls -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,4,0,0" VerticalAlignment="Center">
                        <Button Grid.Column="0" Style="{StaticResource CardButtonStyle}" Content="&#xE892;" Command="{x:Bind MediaViewModel.PreviousCommand}" ToolTipService.ToolTip="Previous" />
                        <Button Grid.Column="1" Style="{StaticResource PlayCircleButtonStyle}" Content="{x:Bind MediaViewModel.IsPlaying, Converter={StaticResource PlayPauseGlyphConverter}, Mode=OneWay}" Command="{x:Bind MediaViewModel.PlayPauseCommand}" Margin="10,0,10,0" ToolTipService.ToolTip="Play/Pause" />
                        <Button Grid.Column="2" Style="{StaticResource CardButtonStyle}" Content="&#xE893;" Command="{x:Bind MediaViewModel.NextCommand}" ToolTipService.ToolTip="Next" />
                        
                        <!-- Volume Slider -->
                        <Grid Grid.Column="4" ColumnDefinitions="Auto,*" Width="140" VerticalAlignment="Center">
                            <Button Grid.Column="0" Style="{StaticResource CardButtonStyle}" Width="28" Height="28" Content="&#xE767;" Click="MuteButton_Click" ToolTipService.ToolTip="Mute/Unmute"/>
                            <Slider Grid.Column="1" 
                                    Minimum="0" 
                                    Maximum="100" 
                                    Value="{x:Bind VolumePercentValue, Mode=TwoWay}" 
                                    Margin="6,0,0,0" 
                                    Height="24"
                                    Foreground="{ThemeResource AccentBrush}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Clipboard Card -->
            <Border Grid.Column="1" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF0E3;" FontFamily="Segoe Fluent Icons" FontSize="12.5" Foreground="{ThemeResource AccentBrush}"/>
                            <TextBlock Text="Clipboard History" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear All" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{ThemeResource AccentBrush}" FontSize="10.5" FontWeight="SemiBold" Click="ClearAllClipboard_Click"/>
                    </Grid>

                    <!-- History Items List -->
                    <StackPanel Grid.Row="1" Spacing="5" VerticalAlignment="Center">
                        <!-- Item 1 (Live Current Item) -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="28" Background="#0AFFFFFF" Padding="8,2" CornerRadius="6">
                            <FontIcon Grid.Column="0" Glyph="&#xE15F;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind LiveClipboardTitle, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Just now" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}" Margin="8,0,8,0" VerticalAlignment="Center"/>
                            <FontIcon Grid.Column="3" Glyph="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FFFFD700" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Item 2 (Mock History) -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="28" Background="#05FFFFFF" Padding="8,2" CornerRadius="6">
                            <FontIcon Grid.Column="0" Glyph="&#xF0E3;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="git clone Microsoft/Windows-appsdk" FontSize="11" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="2m ago" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}" Margin="8,0,8,0" VerticalAlignment="Center"/>
                            <FontIcon Grid.Column="3" Glyph="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Item 3 (Mock History) -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="28" Background="#05FFFFFF" Padding="8,2" CornerRadius="6">
                            <FontIcon Grid.Column="0" Glyph="&#xE15F;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Primary Accent Hex: #FF8B5CF6" FontSize="11" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="10m ago" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}" Margin="8,0,8,0" VerticalAlignment="Center"/>
                            <FontIcon Grid.Column="3" Glyph="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Paste Actions Button -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <Button Grid.Column="0" Content="Paste Active Clipboard Item" Background="#FF2D2D30" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" FontSize="11" Height="28" HorizontalAlignment="Stretch" Click="PasteClipboard_Click"/>
                        <Button Grid.Column="1" Style="{StaticResource CardButtonStyle}" Width="28" Height="28" FontSize="11" Content="&#xE90A;" Margin="8,0,0,0" ToolTipService.ToolTip="View History" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 1: Weather (Left) & Bluetooth Devices (Right) -->
        <Grid Grid.Row="1" ColumnDefinitions="1.25*,1*" ColumnSpacing="0">
            <!-- Weather Card -->
            <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,1,1">
                <Grid>
                    <!-- Unavailable state -->
                    <Grid Visibility="{x:Bind WeatherUnavailableVisibility, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Weather Unavailable" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Opacity="0.7" HorizontalAlignment="Center"/>
                    </Grid>

                    <!-- Real Weather Data -->
                    <Grid RowDefinitions="Auto,*,Auto" Visibility="{x:Bind WeatherAvailableVisibility, Mode=OneWay}">
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" Spacing="6">
                            <FontIcon Glyph="{x:Bind WeatherGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="12.5" Foreground="#FFFFD700"/>
                            <TextBlock Text="Weather" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Temperature & Details -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <FontIcon Grid.Column="0" Glyph="{x:Bind WeatherGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="#FFFFD700" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind WeatherTemp, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind WeatherCondition, Mode=OneWay}" FontSize="9.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Compact Forecast (3 Days) -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="0,4,0,0" Padding="0,4,0,0" BorderThickness="0,1,0,0" BorderBrush="#0AFFFFFF">
                            <!-- Day 1 -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind ForecastDay1Text, Mode=OneWay}" FontSize="8.5" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <FontIcon Glyph="{x:Bind ForecastDay1Glyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FFFFD700" Margin="0,1,0,1"/>
                                <TextBlock Text="{x:Bind ForecastDay1Temp, Mode=OneWay}" FontSize="8.5" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Day 2 -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind ForecastDay2Text, Mode=OneWay}" FontSize="8.5" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <FontIcon Glyph="{x:Bind ForecastDay2Glyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FFFFD700" Margin="0,1,0,1"/>
                                <TextBlock Text="{x:Bind ForecastDay2Temp, Mode=OneWay}" FontSize="8.5" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Day 3 -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind ForecastDay3Text, Mode=OneWay}" FontSize="8.5" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <FontIcon Glyph="{x:Bind ForecastDay3Glyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FFFFD700" Margin="0,1,0,1"/>
                                <TextBlock Text="{x:Bind ForecastDay3Temp, Mode=OneWay}" FontSize="8.5" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bluetooth Devices Card -->
            <Border Grid.Column="1" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- Unavailable or Disabled State (Clean single muted line) -->
                    <Grid Visibility="{x:Bind BtUnavailableVisibility, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind BtStatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Paired Devices List -->
                    <Grid RowDefinitions="Auto,*" Visibility="{x:Bind BtAvailableVisibility, Mode=OneWay}">
                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE702;" FontFamily="Segoe Fluent Icons" FontSize="12.5" Foreground="{ThemeResource AccentBrush}"/>
                                <TextBlock Text="Bluetooth Devices" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Pair new device" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{ThemeResource AccentBrush}" FontSize="10" FontWeight="SemiBold" Click="PairBluetoothDevice_Click"/>
                        </Grid>

                        <!-- Devices list -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind BtDevices, Mode=OneWay}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:BluetoothDeviceUiModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="28" Margin="0,1">
                                            <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontFamily="Segoe Fluent Icons" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="10.5" Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            
                                            <!-- Connection label & battery -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{x:Bind ConnectedText, Mode=OneWay}" FontSize="9" Foreground="{x:Bind ConnectedColor, Mode=OneWay}" FontWeight="Bold" Margin="0,0,6,0"/>
                                                <TextBlock Text="{x:Bind BatteryText, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,3,0" Visibility="{x:Bind BatteryVisibility, Mode=OneWay}"/>
                                                <FontIcon Glyph="&#xE83F;" FontFamily="Segoe Fluent Icons" FontSize="10.5" Foreground="#FF10B981" Visibility="{x:Bind BatteryVisibility, Mode=OneWay}"/>
                                            </StackPanel>
                                            
                                            <!-- Toggle Button -->
                                            <Button Grid.Column="3" Style="{StaticResource BtToggleButtonStyle}" Tag="{x:Bind Id}" Content="{x:Bind ButtonText, Mode=OneWay}" Click="DeviceToggle_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Stats Row (RAM, CPU, Battery, Storage) - 4-up horizontal region -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="0">
            <!-- RAM Card -->
            <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE950;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="RAM" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>
                    
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,2,0,4">
                        <TextBlock Grid.Column="0" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}">
                            <Run Text="{x:Bind RamUsedText, Mode=OneWay}"/>
                            <Run Text=" / " Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <Run Text="{x:Bind RamTotalText, Mode=OneWay}" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{x:Bind RamPercentText, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource AccentBrush}"/>
                    </Grid>

                    <ProgressBar Grid.Row="2" Value="{x:Bind RamPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="3" Foreground="{ThemeResource AccentBrush}" Background="#20FFFFFF" CornerRadius="1.5"/>
                </Grid>
            </Border>

            <!-- CPU Card -->
            <Border Grid.Column="1" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="CPU" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Realtime sparkline visual in center -->
                    <Canvas Grid.Row="1" x:Name="CpuGraphCanvas" Height="22" Margin="0,2,0,2">
                        <Polyline x:Name="CpuGraphLine" Stroke="{ThemeResource AccentBrush}" StrokeThickness="1.5"/>
                    </Canvas>

                    <TextBlock Grid.Row="2" Text="{x:Bind CpuPercentText, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Battery Card -->
            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE83F;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="Battery" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,2,0,2">
                        <!-- Battery icon with overlay bolt icon -->
                        <Grid Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind BatteryGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#FF10B981"/>
                            <FontIcon x:Name="BatteryChargingBoltDashboard"
                                      Glyph="&#xE945;" 
                                      FontFamily="Segoe Fluent Icons" 
                                      FontSize="10" 
                                      Foreground="#FFFFD700"
                                      HorizontalAlignment="Right" 
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,-2,-2"
                                      Visibility="{x:Bind BatteryChargingVisibility, Mode=OneWay}"/>
                        </Grid>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind BatteryPercentText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <TextBlock Text="{x:Bind BatteryStatusText, Mode=OneWay}" FontSize="8" Foreground="#FF10B981" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Storage Card -->
            <Border Grid.Column="3" Style="{StaticResource SectionBorderStyle}" BorderThickness="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE7F1;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="Storage" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,2,0,4">
                        <TextBlock Grid.Column="0" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}">
                            <Run Text="{x:Bind StorageFreeText, Mode=OneWay}"/>
                            <Run Text=" free" FontSize="8.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{x:Bind StorageTotalText, Mode=OneWay}" FontSize="9.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </Grid>

                    <ProgressBar Grid.Row="2" Value="{x:Bind StoragePercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="3" Foreground="{ThemeResource AccentBrush}" Background="#20FFFFFF" CornerRadius="1.5"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
