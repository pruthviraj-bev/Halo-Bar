<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DynamicIsland.Widgets.PomodoroTimerWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="200" Height="200">
    <Border BorderBrush="Gray" BorderThickness="1" Padding="12">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <Ellipse Width="120" Height="120" Stroke="Gray" StrokeThickness="4"/>
            <TextBlock Text="25:00" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="25m" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                <Ellipse Width="6" Height="6" Fill="Gray"/>
                <Ellipse Width="6" Height="6" Fill="LightGray"/>
                <Ellipse Width="6" Height="6" Fill="LightGray"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
