<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DynamicIsland.Widgets.VolumeWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged">

    <Grid x:Name="Root" VerticalAlignment="Center">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- Keep in Collapsed layout for the transient HUD -->
                <VisualState x:Name="Collapsed">
                    <VisualState.Setters>
                        <Setter Target="CollapsedRow.Visibility" Value="Visible" />
                        <Setter Target="ExpandedRow.Visibility"  Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Expanded">
                    <VisualState.Setters>
                        <Setter Target="CollapsedRow.Visibility" Value="Visible" />
                        <Setter Target="ExpandedRow.Visibility"  Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- ── COLLAPSED: HUD format (speaker icon + horizontal fill bar) ── -->
        <Grid x:Name="CollapsedRow"
              ColumnDefinitions="Auto,*,Auto"
              VerticalAlignment="Center"
              Height="36"
              Padding="10,0">

            <FontIcon Grid.Column="0"
                      Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="12"
                      Foreground="{ThemeResource AccentBrush}"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"/>

            <!-- Subtle volume progress bar -->
            <ProgressBar Grid.Column="1"
                         Value="{x:Bind ViewModel.VolumePercent, Mode=OneWay}"
                         Minimum="0"
                         Maximum="100"
                         Height="1.5"
                         Foreground="{ThemeResource AccentBrush}"
                         Background="#15FFFFFF"
                         CornerRadius="0.75"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       Text="{x:Bind ViewModel.VolumePercentText, Mode=OneWay}"
                       FontSize="10"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Redundant expanded row (not used in HUD mode, kept for code behind compatibility) -->
        <Grid x:Name="ExpandedRow" Visibility="Collapsed"/>
    </Grid>
</UserControl>
